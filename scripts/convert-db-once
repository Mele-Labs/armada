#!/usr/bin/env bash
#
# ONE-TIME: carry the owner's database from the numbered migration list to
# names, for the one file that is at count 114 because a preview applied
# `step_baseline::V115` (PR #1831) before names existed. The store converts
# every other numbered file by itself at startup; this one it refuses, since a
# count above 113 does not say which entries it holds. Delete this script once
# that file has been converted. `docs/practices/store-migrations.md`.
#
#   scripts/convert-db-once <path to armada.db>
#
# **Fleet must be stopped first** (`launchctl bootout gui/$UID/com.armada.fleet`,
# or `scripts/restart` is not run until after). Refuses unless the file is a
# numbered database at exactly 114, has no `armada_migrations` table, and has
# `job_step_baselines` with the columns V115 creates. Copies the file to
# `<path>.before-names` first, then does everything in ONE transaction: creates
# `armada_migrations` as the store would, records the 113 numbered entries under
# their names and flags, records step-baseline under the name its file carries,
# and sets `schema_version` to 113 so a build older than names can still open it.
#
# **step-baseline's file, which #1831 must add instead of an entry in the list:**
#   crates/store/migrations/20261006T2300Z-step_baseline.survives_restart.sql
# holding the `CREATE TABLE job_step_baselines` it created. It is additive: its
# SQL only creates a table. The rows below equal `legacy_migrations.rs`, which a
# store test checks.

set -euo pipefail

fail() {
  echo "convert-db-once: $*" >&2
  exit 1
}

[[ $# -eq 1 ]] || fail "usage: scripts/convert-db-once <path to armada.db>"
db="$1"
[[ -f "$db" ]] || fail "$db is not a file"
command -v sqlite3 >/dev/null || fail "sqlite3 is not on PATH"

if command -v lsof >/dev/null && [[ -n "$(lsof -t -- "$db" "$db-wal" 2>/dev/null || true)" ]]; then
  fail "a process holds $db — stop Fleet first (launchctl bootout gui/$(id -u)/com.armada.fleet) and run again"
fi

q() { sqlite3 "$db" "$1"; }

[[ "$(q "SELECT value FROM armada_meta WHERE key = 'schema_version'" 2>/dev/null || true)" == 114 ]] \
  || fail "$db is not a numbered database at exactly version 114 — the store converts any other one itself"
[[ "$(q "SELECT count(*) FROM sqlite_master WHERE name = 'armada_migrations'")" == 0 ]] \
  || fail "$db already has armada_migrations — it is converted"
[[ "$(q "SELECT group_concat(name) FROM (SELECT name FROM pragma_table_info('job_step_baselines') ORDER BY name)")" == "entries,job_id,step_id" ]] \
  || fail "$db has no job_step_baselines with job_id, step_id and entries — it is not the file a preview of #1831 migrated"
[[ "$(q "PRAGMA integrity_check")" == ok ]] || fail "$db fails PRAGMA integrity_check"

before="$db.before-names"
[[ ! -e "$before" ]] || fail "$before exists — move it aside and run again"
sqlite3 "$db" ".backup '$before'" || fail "could not copy $db to $before"
echo "convert-db-once: copied to $before" >&2

sqlite3 -bail "$db" <<'SQL'
BEGIN IMMEDIATE;
CREATE TABLE IF NOT EXISTS armada_migrations (
    name TEXT PRIMARY KEY,
    additive INTEGER NOT NULL CHECK (additive IN (0, 1))
) STRICT;
INSERT INTO armada_migrations (name, additive) VALUES
  ('schema.v1',1),
  ('schema.v2',0),
  ('schema.v3',1),
  ('schema.v4',0),
  ('schema.v5',0),
  ('schema.v6',1),
  ('schema.v7',0),
  ('schema.v8',1),
  ('schema.v9',1),
  ('schema.v10',1),
  ('schema.v11',0),
  ('schema.v12',1),
  ('schema.v13',0),
  ('schema.v14',0),
  ('schema.v15',1),
  ('schema.v16',0),
  ('report.v17',1),
  ('plan.v18',1),
  ('drone.v19',0),
  ('note.v20',1),
  ('delivery.v21',1),
  ('judged.v22',1),
  ('spend.v23',1),
  ('gaming.v24',1),
  ('footprint.v25',0),
  ('delivery.v26',1),
  ('process.v27',1),
  ('attempt.v28',0),
  ('proving.v29',1),
  ('judged.v30',1),
  ('remarks.v31',1),
  ('spend.v32',1),
  ('spend.v33',0),
  ('proposing.v34',1),
  ('judged.v35',1),
  ('numbering.v36',0),
  ('showing.v37',1),
  ('retain.v38',1),
  ('gaming.v39',1),
  ('spend.v40',1),
  ('showing.v41',1),
  ('showing.v42',1),
  ('shown_again.v43',1),
  ('allowing.v44',1),
  ('ports.v45',1),
  ('manifest_snapshot.v46',1),
  ('review.v47',1),
  ('delivery.v48',1),
  ('model_override.v49',1),
  ('ports.v50',0),
  ('delivery.v51',1),
  ('asking.v52',1),
  ('drift.v53',1),
  ('shown_again.v54',1),
  ('limits.v55',1),
  ('manifest_allowed.v56',1),
  ('repositories.v57',0),
  ('retrace.v58',0),
  ('work_plan.v59',1),
  ('review_record.v60',1),
  ('review_view.v61',1),
  ('preferences.v62',1),
  ('review_dismissals.v63',1),
  ('helm_sessions.v64',1),
  ('review_model.v65',1),
  ('review_followups.v66',1),
  ('limits.v67',1),
  ('breakages.v68',1),
  ('breakages.v69',1),
  ('reuse.v70',1),
  ('timings.v71',1),
  ('timings.v72',1),
  ('gaming.v73',1),
  ('rechecking.v74',0),
  ('delivery.v75',1),
  ('pending_evidence.v76',1),
  ('studio.v77',1),
  ('studio.v78',1),
  ('studio.v79',0),
  ('work_plan.v80',1),
  ('kit.v81',1),
  ('lineage.v82',1),
  ('ports.v83',0),
  ('studio.v84',0),
  ('studio.v85',0),
  ('studio.v86',0),
  ('resolved_policies.v87',1),
  ('checked.v88',1),
  ('resolved_policies.v89',1),
  ('work_plan.v90',0),
  ('studio.v91',0),
  ('task_drones.v92',1),
  ('slot.v93',1),
  ('breakages.v94',1),
  ('groups.v95',0),
  ('pull_request_kept.v96',1),
  ('model_per_task.v97',0),
  ('approval.v98',1),
  ('crew.v99',1),
  ('retro.v100',1),
  ('waves.v101',1),
  ('retro.v102',1),
  ('walk_notes.v103',1),
  ('approval.v104',1),
  ('retro.v105',1),
  ('slot_rescues.v106',1),
  ('slot_rescues.v107',1),
  ('merge_line.v108',1),
  ('check_runs.v109',1),
  ('retro.v110',1),
  ('pausing.v111',1),
  ('asked_runs.v113',1),
  ('main_ci.v114',1),
  ('step_baseline.survives_restart',1);
UPDATE armada_meta SET value = '113' WHERE key = 'schema_version';
COMMIT;
SQL

echo "convert-db-once: $db now records 114 migrations by name" >&2

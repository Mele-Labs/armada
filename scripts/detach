#!/usr/bin/env python3
#
# Run a command in a session of its own, with its output in a log, and follow
# that log from where this run began until the command exits. Exits with the
# command's code. `scripts/restart` and `scripts/preview --restart` start
# themselves through it.
#
#   scripts/detach <log> <command> [args...]
#
# **A restart that Fleet's own Run started dies with the Fleet it stops.** Fleet
# holds the run's terminal; booting Fleet out closes it, the script gets SIGHUP and
# exits before it bootstraps the new Fleet. So the command here has a session of
# its own, SIGHUP ignored, no stdin, and no terminal to lose. This process only
# reads the log: it never signals the command, and if it is hung up it just goes
# while the command carries on.
#
# The command gets `ARMADA_RESTART_DETACHED=1`, so a script it calls does not
# detach again, and loses `ARMADA_SPAWNED_BY`, which the next Fleet's orphan sweep
# (`crates/fleet/src/orphans.rs`) reads as a reason to end a group.

import os
import signal
import subprocess
import sys
import time

MARK = "ARMADA_RESTART_DETACHED"
FLEET_MARK = "ARMADA_SPAWNED_BY"
EVERY = 0.1


def ignore_hangup():
    signal.signal(signal.SIGHUP, signal.SIG_IGN)


def main():
    if len(sys.argv) < 3:
        sys.exit("usage: scripts/detach <log> <command> [args...]")
    log, command = os.path.abspath(sys.argv[1]), sys.argv[2:]
    os.makedirs(os.path.dirname(log), exist_ok=True)
    print(f"restart: log {log}", flush=True)
    env = {k: v for k, v in os.environ.items() if k != FLEET_MARK}
    env[MARK] = "1"
    with open(log, "ab") as out:
        began = out.tell()
        try:
            child = subprocess.Popen(
                command, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                env=env, start_new_session=True, preexec_fn=ignore_hangup)
        except OSError as why:
            print(f"restart: cannot run {command[0]}: {why}", file=sys.stderr)
            return 127
    try:
        with open(log, "rb") as reading:
            reading.seek(began)
            while True:
                code = child.poll()
                fresh = reading.read()
                if fresh:
                    sys.stdout.buffer.write(fresh)
                    sys.stdout.buffer.flush()
                if code is not None:
                    return code if code >= 0 else 128 - code
                if not fresh:
                    time.sleep(EVERY)
    except KeyboardInterrupt:
        print(f"restart: stopped following. The run goes on, log {log}", file=sys.stderr)
        return 130
    except OSError:
        # The terminal this was reading for is gone; the run is not its to end.
        return 1


if __name__ == "__main__":
    sys.exit(main())

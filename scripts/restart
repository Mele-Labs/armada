#!/usr/bin/env bash
#
# Move the running Fleet — and Bridge and the native Bridge, once they need to — onto whatever is in
# this working tree. Two callers: an agent, through Bash, after a merge that
# touches Fleet or Bridge; and Bridge itself, from its own "restart on latest
# build" act. Never on an allow list — `.claude/skills/preview-app/SKILL.md`
# says why, and says what to tell the owner before running this.
#
# **launchd is the parent, and that is the whole design.** `scripts/dev` starts
# Fleet as this script's own child, which works until the shell that started it
# ends. An agent's session ends. So Fleet here is never spawned directly — this
# script only ever talks to launchd, which is the one thing left holding it
# once the caller is gone. `docs/concepts/fleet.md`, Daemon lifecycle and
# Restarting Fleet, is the design; this is the first thing that builds it.
#
# **Everything here is derived from `$HOME`, deliberately**, so a test against
# a `scripts/dev-fleet` scratch home can never reach the owner's plist, runtime
# file or launchd job. `ARMADA_FLEET_LABEL` overrides the label for the same
# reason, for the one thing `$HOME` cannot separate: launchd's `gui/$UID`
# domain is one namespace per machine user, not per home directory, so two
# Fleets tested under two scratch homes would still collide on `com.armada.fleet`
# without it.

set -euo pipefail

caller_pwd=$PWD
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

home="${HOME:?HOME must be set}"
support="$home/Library/Application Support/Armada"
runtime="$support/fleet.json"

label="${ARMADA_FLEET_LABEL:-com.armada.fleet}"
plist="$support/$label.plist"
domain="gui/$(id -u)"
service="$domain/$label"

bridge_label="$label.bridge"
bridge_plist="$support/$bridge_label.plist"
bridge_service="$domain/$bridge_label"

# The native Bridge (`crates/bridge-native`) is a job of its own beside Bridge's, so a quit of
# one is never read as the other's.
native_label="$label.native"
native_plist="$support/$native_label.plist"
native_service="$domain/$native_label"

# The Phone Gateway's old launchd job, retired: Fleet serves the phone itself
# now, and the old job would hold the port Fleet's Gateway binds. Under a label
# override it follows the override, so a dev-fleet run never names the owner's
# `com.armada.pocket`.
if [[ "$label" == com.armada.fleet ]]; then pocket_label=com.armada.pocket; else pocket_label="$label.pocket"; fi
pocket_plist="$support/$pocket_label.plist"
pocket_service="$domain/$pocket_label"

# `say` is commentary, not the answer — it goes to stderr so a caller that
# captures this script's stdout for the final report never captures a
# progress line by accident.
say() { printf '\n\033[1m%s\033[0m\n' "$*" >&2; }
fail() {
  echo "restart: $*" >&2
  exit 1
}

# `--from <worktree>` builds `armada` and Bridge from another tree while Fleet
# keeps serving the repository this script lives in — `scripts/preview` uses it
# to run a merge of unlanded branches. `docs/practices/running-locally.md`, "A
# preview of unlanded work". Without it everything below reads `$root` as it
# always did, and nothing in this block runs.
from=""
dry_run=false
adopt=false
keep_only=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)
      [[ $# -ge 2 ]] || fail "--from needs a worktree"
      from="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --adopt)
      adopt=true
      shift
      ;;
    --main)
      leave_preview=true
      shift
      ;;
    --keep-only)
      keep_only=true
      shift
      ;;
    *)
      fail "unknown argument $1 — usage: scripts/restart [--from <worktree>] [--main] [--dry-run] [--adopt] [--keep-only]"
      ;;
  esac
done

# **A plain restart while the preview runs refreshes the preview.** Rebuilding
# from this checkout would quietly swap the owner's preview for `main` alone;
# `scripts/preview --restart` re-merges onto the latest `main` and comes back
# here with `--from`. `--main` is the way back to `main` alone.
recorded_source=$(cat "$support/restart-source" 2>/dev/null || true)
if [[ -z "$from" && "${leave_preview:-false}" == false && "$recorded_source" == */.armada/preview ]]; then
  preview="${ARMADA_RESTART_PREVIEW:-$root/scripts/preview}"
  say "The preview is running — refreshing it onto the latest main (scripts/restart --main leaves it)"
  exec "$preview" --restart $($dry_run && echo --dry-run) $($adopt && echo --adopt) $($keep_only && echo --keep-only)
fi

# **Plain restart builds the latest `main`, not whatever this checkout last
# pulled.** On 17 Sep a checkout four merges behind was rebuilt faithfully and
# Fleet came back on the protocol it started on. Only a checkout on `main` is
# moved, and only forward.
if [[ -z "$from" ]] && ! $dry_run && [[ "$(git -C "$root" branch --show-current 2>/dev/null)" == main ]]; then
  say "Fast-forwarding main to origin/main"
  git -C "$root" pull --ff-only --quiet origin main \
    || fail "main cannot fast-forward to origin/main — it has diverged or a local change is in the way"
fi

src="$root"
if [[ -n "$from" ]]; then
  src=$(cd "$caller_pwd" && cd "$from" 2>/dev/null && pwd) || fail "--from $from is not a directory"
  [[ -f "$src/crates/armada/Cargo.toml" && -d "$src/apps/desktop" ]] \
    || fail "--from $src has no crates/armada and apps/desktop — it is not a checkout of this repository"
fi
$dry_run && [[ -z "$from" ]] && fail "--dry-run is for --from"

# One restart at a time. Two runs overlapping on 12 Sep left one sending
# SIGTERM to Fleet while the other's late Drone check found the pid alive
# and its API refusing connections, and failed on it. macOS has no
# `flock(1)`, so the lock is a symlink — `lock_path` pointing at the holder's
# pid — rather than a directory with a pid file written into it after the
# fact. `ln -s` is one syscall: the link either comes into being already
# naming its holder, or the call fails, so there is no window where a lock
# exists and a reader sees no pid yet. A `mkdir`-then-write pair has exactly
# that window, and a second run landing inside it would read an empty pid,
# call the lock stale, and take it out from under the first run — the
# concurrent case this exists to prevent. Derived from `$home`, like
# everything else here, so a scratch-`HOME` test can never contend with the
# owner's own restart.
#
# **A dead pid is never broken automatically.** A first attempt did: two
# runs that both read the same dead pid could each remove what the other
# had just recreated and both come away holding the lock — a race a
# 50-round loop kept reproducing no matter how the removal was made atomic,
# because the removal and the recreation are still two separate steps that
# a second run can interleave with. A lock only outlives its holder when a
# restart itself was killed, which is rare, so this refuses instead and
# names the fix: remove the lock directory yourself and run again. One
# manual `rm` beats a race in the one case this lock exists for.
lock_path="$support/restart.lock"

release_lock() {
  [[ "${lock_held:-false}" == true ]] && rm -f "$lock_path" 2>/dev/null || true
}

# A symlink's target is fixed at creation, so this is the one read that can
# never land mid-write: either the link is not there, or it names a pid in
# full.
read_lock_pid() { readlink "$lock_path" 2>/dev/null || true; }

acquire_lock() {
  mkdir -p "$support"

  if ln -s "$$" "$lock_path" 2>/dev/null; then
    lock_held=true
    return
  fi

  local held_pid
  held_pid=$(read_lock_pid)
  if [[ -n "$held_pid" ]] && kill -0 "$held_pid" 2>/dev/null; then
    fail "another restart is already in progress (pid $held_pid)"
  fi

  if [[ -n "$held_pid" ]]; then
    fail "a previous restart (pid $held_pid) died holding the lock — remove $lock_path and run again"
  fi
  fail "a previous restart died holding the lock and left $lock_path naming no pid — remove it and run again"
}

lock_held=false
trap release_lock EXIT
trap 'exit 1' INT TERM HUP
# A dry run writes nothing, and the lock is a file.
$dry_run || acquire_lock

# cargo's own default install root, so a `$HOME` overridden for testing does
# not also relocate where `armada` gets installed — that is shared machine
# tooling, not Fleet's per-home state, and installing it from this working
# tree is the same harmless refresh a plain `cargo install` always is.
cargo_home="${CARGO_HOME:-$home/.cargo}"
armada_bin="$cargo_home/bin/armada"

# Refuse while a Drone is working.
#
# **Read off the roster, never off the Jobs.** `crates/ipc/src/drones.rs`:
# an escalated Job keeps its Drone alive and idle, so a status count would
# either miss it or, read the other way, refuse a restart nothing is using.
# What refuses is a Drone whose Job is `running` — `docs/concepts/fleet.md`'s
# own reading of `job-statuses.toml`, where `running` is the one status a live
# Drone process stands for. A Fleet that answers 404 for the roster runs no
# Drones (#28 deleted them), so nothing is working and the restart goes ahead.
#
# **Called twice, deliberately.** Once here, before paying for a rebuild that
# can run minutes, so an obvious refusal is fast. Again immediately before
# Fleet is touched, because a queued Job can be admitted while `cargo install`
# and `pnpm build` run, and the read from before the build is stale by then.
# Sets `old_pid`/`old_port` as plain (not `local`) variables — this runs as a
# statement, never inside `$(...)`, because `fail`'s `exit` would only kill a
# subshell wrapped around a command substitution and the refusal would go
# unnoticed by the caller.
#
# **`--adopt` skips both refusals and prints what it costs instead.** Fleet
# adopts a Drone that outlives it (`docs/concepts/drone.md`, "A Drone that
# outlives its Fleet is adopted"), so a working Drone is survivable, not
# forbidden — the owner who passes `--adopt` has accepted the costs below. The
# roster is still read first, and a roster that does not answer still refuses:
# without it nothing says which Jobs are being adopted.
adopt_costs_said=false
say_adopt_costs() {
  $adopt_costs_said && return
  adopt_costs_said=true
  cat >&2 <<'COSTS'
adopting costs, for each Job above:
  its pipes die, so it cannot be redirected, poked or handed a verdict
  its recorded spend is an undercount
  its Job shows as `unheard`
  a Job's servers stop when Fleet stops
  a Check running mid-gate most likely dies with Fleet and the gate re-runs from scratch (fleet-checks-runner-sweep-timing is open, so a surviving Check group is not swept at boot)
  a Drone that cannot be adopted is ended
COSTS
}

refuse_if_drone_working() {
  old_pid=""
  old_port=""
  if [[ -f "$runtime" ]]; then
    old_pid=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["pid"])' "$runtime" 2>/dev/null || true)
    old_port=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["port"])' "$runtime" 2>/dev/null || true)
  fi

  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    say "Fleet is running (pid $old_pid, port $old_port) — checking for a working Drone"
    result=$(python3 - "$old_port" "$($adopt && echo adopt || echo refuse)" <<'PY'
import json, sys, urllib.error, urllib.request

port = sys.argv[1]


def get(path):
    with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=30) as r:
        return json.load(r)


adopt = sys.argv[2] == "adopt"
try:
    working = []
    try:
        roster = get("/drones")["drones"]
    except urllib.error.HTTPError as e:
        # A Fleet built after the Drones were deleted has no such route; any other error is still an error.
        if e.code != 404:
            raise
        roster = None
    for d in roster or []:
        job = get(f"/jobs/{d['job_id']}")["job"]
        if job["status"] == "running":
            working.append(f"{d['handle']} ({d['job_id']})")
            if not adopt:
                break
    if roster is None:
        print("NODRONES")
    elif not working:
        print("OK")
    elif adopt:
        print("ADOPT:" + "\t".join(working))
    else:
        print(f"REFUSE:{working[0].split(' (')[0]}")
except (urllib.error.URLError, OSError, ValueError) as e:
    print(f"ERROR:{e}")
PY
    )
    case "$result" in
      OK)
        say "No Drone is working"
        ;;
      NODRONES)
        say "This Fleet runs no Drones, so none is working"
        ;;
      ADOPT:*)
        say "Adopting every working Drone — --adopt skips the refusal"
        printf '%s\n' "${result#ADOPT:}" | tr '\t' '\n' | sed 's/^/  /' >&2
        say_adopt_costs
        ;;
      REFUSE:*)
        fail "refusing — ${result#REFUSE:}'s Drone is working"
        ;;
      ERROR:*)
        fail "fleet.json names a live pid but the API on port $old_port did not answer: ${result#ERROR:}"
        ;;
      *)
        fail "could not read what $old_port answered: $result"
        ;;
    esac
  fi
}

backups="$support/backups"
# Where the builds this script keeps are, and the one launchd runs. `scripts/keep-build`.
builds="$support/builds"
kept_current="$builds/current"

# The migration guard, for `--from`. **Names, never a count**: a migration is
# a file in `crates/store/migrations/` (the 113 before files are named in
# `legacy_migrations.rs`) with an additive or breaking flag, and the database
# records the names it has applied in
# `armada_migrations`. `docs/practices/store-migrations.md` has the rules.
#
# Two refusals, both before Fleet is touched:
#   - the database has applied a breaking migration the build does not list,
#     so that Fleet would refuse the file;
#   - the build lists a breaking migration `origin/main` does not, which the
#     database has not applied, so previewing it would migrate the real
#     database with unlanded work. An additive one is allowed and said.
#
# **The database is read three times read-only, then from a copy.** On 6 Oct
# `sqlite3 -readonly` answered "unable to open database file (14)" for as long
# as launchd was crash-looping Fleet: a WAL file with no usable -shm cannot be
# opened read-only. A copy of the three files is opened read-write in a scratch
# directory, which recovers the WAL there and leaves the real files alone.
# A file this cannot read at all is refused, not guessed at.
#
# Prints one line: `OK <what to say>` or `REFUSE <why>`.
migration_guard() {
  python3 - "$src" "$root" "$support/armada.db" <<'PY'
import os, re, shutil, sqlite3, subprocess, sys, tempfile, time

src, root, db = sys.argv[1:4]
LEGACY_FILE = "crates/store/src/legacy_migrations.rs"
OLD = "crates/store/src/migrations.rs"
DIR = "crates/store/migrations"
FILE_NAME = re.compile(r"\d{8}T\d{4}Z-([a-z0-9_]+\.[a-z0-9_.]+)\.sql")
LEGACY = 113


def names_in(text):
    """[(name, breaking)] in list order, from the named list or the old numbered one.
    An old entry has no flag, so it is breaking: nothing says otherwise."""
    found = [(m.group(2), m.group(1) == "breaking")
             for m in re.finditer(r'Migration::(additive|breaking)\("([^"]+)"', text)]
    if found:
        return found
    inside = False
    for line in text.splitlines():
        t = line.strip()
        if not inside:
            inside = "pub const MIGRATIONS" in t
        elif t == "];":
            break
        elif m := re.fullmatch(r"(?:crate::(\w+)::|(?:\w+::)*)V(\d+),", t):
            found.append((f"{m.group(1) or 'schema'}.v{m.group(2)}", True))
    return found


def read(path):
    try:
        return open(os.path.join(src, path)).read()
    except OSError:
        return ""


def git_show(path):
    shown = subprocess.run(["git", "-C", root, "show", f"origin/main:{path}"], capture_output=True, text=True)
    return shown.stdout if shown.returncode == 0 else ""


def from_files(listing, text_of):
    """[(name, breaking)] for the migration files in `listing`, by file name."""
    found = []
    for file in sorted(listing):
        m = FILE_NAME.fullmatch(file)
        if m:
            head = []
            for line in text_of(file).splitlines():
                if line.strip() and not line.lstrip().startswith("--"):
                    break
                head.append(line.strip())
            found.append((m.group(1), "-- breaking" in head))
    return found


def target_names():
    legacy = names_in(read(LEGACY_FILE) or read(OLD))
    if not legacy:
        return []
    try:
        listing = os.listdir(os.path.join(src, DIR))
    except OSError:
        listing = []
    return legacy + from_files(listing, lambda f: read(f"{DIR}/{f}"))


def main_names():
    legacy = names_in(git_show(LEGACY_FILE) or git_show(OLD))
    if not legacy:
        return None
    tree = subprocess.run(["git", "-C", root, "ls-tree", "--name-only", "origin/main", DIR + "/"],
                          capture_output=True, text=True).stdout.split()
    return {n for n, _ in legacy} | {n for n, _ in from_files([os.path.basename(t) for t in tree], lambda f: "")}


def query(path, mode):
    con = sqlite3.connect(f"file:{path}?mode={mode}", uri=True, timeout=5)
    try:
        has = con.execute("SELECT count(*) FROM sqlite_master WHERE name = 'armada_migrations'").fetchone()[0]
        if has:
            return {n: bool(a) for n, a in con.execute("SELECT name, additive FROM armada_migrations")}
        row = con.execute("SELECT value FROM armada_meta WHERE key = 'schema_version'").fetchone()
        if row is None or not row[0].isdigit():
            raise sqlite3.DatabaseError("armada_meta has no readable schema_version")
        return int(row[0])
    finally:
        con.close()


def live():
    if not os.path.isfile(db):
        return None
    err = None
    for attempt in range(3):
        try:
            return query(db, "ro")
        except sqlite3.Error as e:
            err = e
            time.sleep(0.5)
    scratch = tempfile.mkdtemp()
    try:
        for suffix in ("", "-wal", "-shm"):
            if os.path.exists(db + suffix):
                shutil.copy2(db + suffix, os.path.join(scratch, "armada.db" + suffix))
        return query(os.path.join(scratch, "armada.db"), "rwc")
    except (sqlite3.Error, OSError) as e:
        print(f"REFUSE cannot read the applied migrations in {db} ({err}; from a copy: {e}), "
              "so cannot tell what this build would apply to it")
        sys.exit(0)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


NO_BRANCH = "a branch not on origin/main"


def branch_of(name):
    """The branch that added `name` to the build, where git can say."""
    sha = subprocess.run(["git", "-C", src, "log", "--diff-filter=A", "--format=%H", "--", DIR],
                         capture_output=True, text=True).stdout.split()
    sha = [c for c in sha if name in subprocess.run(
        ["git", "-C", src, "show", "--name-only", "--format=", c], capture_output=True, text=True).stdout]
    if sha:
        held = subprocess.run(["git", "-C", src, "for-each-ref", "--contains", sha[-1], "refs/heads",
                               "--format=%(refname:short)"], capture_output=True, text=True).stdout.split()
        held = [b for b in held if b not in ("main", "preview")]
        if held:
            return held[0]
    return NO_BRANCH


target = target_names()
if not target:
    print(f"REFUSE cannot read the migrations in {src}/{LEGACY_FILE}, so cannot tell whether this build is older than the database")
    sys.exit(0)
target_names = {n for n, _ in target}
applied = live()

if isinstance(applied, int):
    if applied > LEGACY:
        print(f"REFUSE {db} records numbered version {applied}, past the {LEGACY} the numbered list held; that Fleet could not place it")
        sys.exit(0)
    applied = {n: True for n, _ in target[:applied]}
elif applied is None:
    applied = {}

unknown_breaking = [n for n, additive in applied.items() if n not in target_names and not additive]
if unknown_breaking:
    print(f"REFUSE the database has applied breaking migrations {src}'s build does not list ({', '.join(unknown_breaking)}); that Fleet would refuse the file")
    sys.exit(0)
extra = [n for n in applied if n not in target_names]

main_names_ = main_names()
if main_names_ is None:
    print(f"REFUSE cannot read the migrations on origin/main from {root} (git show origin/main:{LEGACY_FILE}), so cannot tell which are unlanded; fetch it and run again")
    sys.exit(0)
unlanded = [(n, b) for n, b in target if n not in main_names_]
fresh = [(n, b) for n, b in unlanded if n not in applied]
breaking = [n for n, b in fresh if b]
if breaking:
    # The cause goes first: restart-build cuts the line it keeps to 200 characters.
    owners = {n: branch_of(n) for n in breaking}
    where = "; ".join(f"{n} from {b}" for n, b in owners.items())
    print(f"REFUSE {where}: breaking and not on origin/main, so it would migrate the real database with unlanded work, and a build of main could not open it afterwards")
    # One line per branch, for scripts/preview to leave it out and go again.
    by_branch = {}
    for n, b in owners.items():
        if b != NO_BRANCH:
            by_branch.setdefault(b, []).append(n)
    for b, names in by_branch.items():
        print(f"leave out {b}: breaking migration {', '.join(names)} is not on main")
    sys.exit(0)
said = [f"{len(target)} migrations listed, {len(applied)} applied"]
if fresh:
    said.append("unlanded and additive, so safe to go back from: " + ", ".join(n for n, _ in fresh))
if extra:
    said.append("applied and not listed here, all additive: " + ", ".join(extra))
print("OK " + "; ".join(said))
PY
}

if [[ -n "$from" ]]; then
  guarded=$(migration_guard)
  verdict=${guarded%%$'\n'*}
  case "$verdict" in
    OK\ *) say "Migration guard: ${verdict#OK }" ;;
    REFUSE\ *)
      while IFS= read -r line; do
        [[ "$line" == "leave out "* ]] && echo "restart: $line" >&2
      done <<< "$guarded"
      fail "refusing — ${verdict#REFUSE }" ;;
    *) fail "refusing — the migration guard answered nothing readable" ;;
  esac
fi

# The command that builds the phone app: its own `build` script once it has
# one, else vite directly.
pocket_build_cmd() {
  if node -e 'process.exit(require(process.argv[1]).scripts?.build ? 0 : 1)' "$src/apps/pocket/package.json" 2>/dev/null; then
    echo "pnpm -C apps/pocket build"
  else
    echo "pnpm -C apps/pocket exec vite build"
  fi
}
# Where the Gateway serves the app from: a copy outside any source tree, since a
# later `scripts/preview` rebuilds its tree from scratch and deletes `dist`.
pocket_app="$support/pocket-app"
# Copy the built app beside it, then swap it in with a rename, so the Gateway
# never serves a half-copied folder.
install_pocket_app() {
  local fresh="$support/pocket-app.new.$$" old="$support/pocket-app.old.$$"
  rm -rf "$fresh" "$old"
  cp -R "$src/apps/pocket/dist" "$fresh" || fail "could not copy $src/apps/pocket/dist to $fresh"
  if [[ -d "$pocket_app" ]]; then mv "$pocket_app" "$old"; fi
  mv "$fresh" "$pocket_app"
  rm -rf "$old"
}
pocket_stamp="$src/apps/pocket/dist/.armada-restart-stamp"
pocket_stale() {
  [[ -f "$pocket_stamp" ]] || return 0
  [[ -n "$(find "$src/apps/pocket" "$src/packages" -type f -not -path '*/node_modules/*' -not -path "$src/apps/pocket/dist/*" \
      -not -name '*.tsbuildinfo' -newer "$pocket_stamp" -print 2>/dev/null | head -n 1)" ]]
}

# The protocol ID the tree's wire files hash to, and the one the last `ipc`
# build compiled in. They differ when cargo did not run the build script
# although the files changed (a target directory carried from another tree), and
# Fleet then reports the previous ID. Compared here so the install below can be
# made to rebuild `ipc`; compared again against what Fleet reports.
tree_protocol() {
  node "$src/apps/desktop/codegen/protocol-id.mjs"
}
ipc_built_protocol() {
  local out
  out=$(ls -t "${CARGO_TARGET_DIR:-$src/target}"/installed/build/ipc-*/out/protocol_id.rs 2>/dev/null | head -n 1 || true)
  [[ -n "$out" ]] || return 0
  sed -n 's/^const PROTOCOL_ID_HASH: &str = "\([0-9a-f]*\)";$/\1/p' "$out"
}
# Whether the Bridge in `out/` was built for another protocol than the tree's.
# Its build compiles the ID into `out/main/index.js`, and the wire files it
# hashes include `crates/ipc` and `crates/api`, which the mtime check never
# reads. Confirmed 14 Oct 2026: a restart moved Fleet to a new protocol, said
# "Bridge is unchanged", and left Bridge unable to connect.
bridge_protocol_stale() {
  local main="$src/apps/desktop/out/main/index.js"
  [[ -f "$main" ]] && ! grep -qF "\"$(tree_protocol)\"" "$main"
}

# **Bridge runs from a copy of Electron.app that is named Armada Classic**, made by
# `scripts/armada-electron`, which has the reason. Prints the binary Bridge is
# run with. `scripts/keep-build` makes it for a real restart; only the dry run asks here.
armada_electron() {
  "$root/scripts/armada-electron" $($dry_run && echo --dry-run) "$src"
}

# **The native Bridge builds with cargo from its own manifest**: it has its own workspace and
# lockfile, so the root build never reaches it. Its stamp sits beside the binary and holds the
# protocol the build was made for, because `ipc` is linked in and nothing in the binary says
# which wire it speaks. `native_why` says what made it stale.
native_dir="$src/crates/bridge-native"
native_binary="$native_dir/target/release/bridge-native"
native_stamp="$native_dir/target/release/.armada-restart-stamp"
native_pending="$native_stamp.pending"
native_present() { [[ -f "$native_dir/Cargo.toml" ]]; }
native_stale() {
  if [[ ! -f "$native_binary" || ! -f "$native_stamp" ]]; then
    native_why="no build stamp there"
  elif [[ "$(cat "$native_stamp")" != "$(tree_protocol)" ]]; then
    native_why="it was built for another protocol than $(tree_protocol)"
  elif [[ -n "$(find "$native_dir" "$src/crates/ipc" "$src/crates/core-model" "$src/packages/tokens" -type f \
      -not -path '*/node_modules/*' -not -path "$native_dir/target/*" -newer "$native_stamp" -print 2>/dev/null | head -n 1)" ]]; then
    native_why="crates/bridge-native, crates/ipc, crates/core-model or packages/tokens moved since its last build"
  else
    return 1
  fi
}

if $dry_run; then
  say "Dry run — nothing below happens"
  echo "would install armada from $src (cargo install --path crates/armada --profile installed --locked) to $armada_bin"
  if [[ ! -f "$src/apps/desktop/out/.armada-restart-stamp" ]]; then
    echo "would build Bridge from $src — no build stamp there"
  elif bridge_protocol_stale; then
    echo "would build Bridge from $src — it was built for another protocol than $(tree_protocol)"
  elif [[ -n "$(find "$src/apps" "$src/packages" -type f -not -path '*/node_modules/*' -not -path "$src/apps/desktop/out/*" \
      -not -path "$src/apps/desktop/release/*" -not -name '*.tsbuildinfo' -newer "$src/apps/desktop/out/.armada-restart-stamp" -print 2>/dev/null | head -n 1)" ]]; then
    echo "would build Bridge from $src — apps/ or packages/ moved since its last build"
  else
    echo "would not build Bridge — unchanged since its last build in $src"
  fi
  if [[ "$(cat "$support/restart-source" 2>/dev/null || true)" != "$src" ]]; then
    echo "would rebuild and reopen Bridge — the running one was built from $(cat "$support/restart-source" 2>/dev/null || echo "$root")"
  fi
  if [[ -f "$support/armada.db" ]]; then
    echo "would snapshot $support/armada.db to $backups/armada-<UTC stamp>.db, keeping the newest 5"
  else
    echo "would take no snapshot — there is no database yet"
  fi
  kept_lock=$(shasum -a 256 "$src/pnpm-lock.yaml" 2>/dev/null | cut -c1-16 || true)
  echo "would keep the build in $builds/<UTC stamp>-<short commit of $src>: armada, a copy of Bridge's out/ and sounds/, and a launcher; node_modules in $support/node_modules/${kept_lock:-<lockfile hash>}, cloned only if it is not there"
  echo "would have the kept build open a copy of $support/armada.db first, and swap nothing if it cannot"
  echo "would point $kept_current at it and $builds/previous at the build it replaces, keeping the newest 5 and the two links' builds"
  echo "would write $plist: [$kept_current/armada, serve, $root]"
  echo "would boot $service out if it is loaded, then bootstrap it from $plist"
  echo "would wait up to 60 s for the new Fleet to answer /health, and otherwise mark the build and swap back onto the one before"
  echo "would write $bridge_plist: [$kept_current/bridge-launch, $kept_current/launch-bridge] in $kept_current/bridge, reopened by launchd when it stops without a quit"
  echo "would reopen Bridge too if its job is loaded from anywhere but $kept_current/bridge, or the kept Bridge's main, preload or Electron differ from the build before's; where only its page differs, Bridge reloads it in place"
  if bridge_electron=$(armada_electron); then
    echo "would keep Bridge's Electron as $bridge_electron — a copy of Electron.app named Armada Classic with the Classic icon, ad hoc signed, made if missing, kept once per Electron version in $support/electron"
  else
    echo "WARNING: no Electron.app under $src/apps/desktop/node_modules, so Bridge would say Electron"
  fi
  echo "Bridge would run the kept copy of $src/apps/desktop/out, built from $src"
  if native_present; then
    if native_stale; then
      echo "would build the native Bridge from $src — $native_why"
    else
      echo "would not build the native Bridge — unchanged since its last build in $src"
    fi
    echo "would keep the native Bridge as $kept_current/Armada.app — its binary named Armada, an Info.plist, the brand icon, ad hoc signed"
    echo "would write $native_plist: [$kept_current/bridge-launch, $kept_current/Armada.app/Contents/MacOS/Armada] in $kept_current, reopened by launchd when it stops without a quit"
    echo "would open the native Bridge too if its job is not loaded or is loaded from anywhere but $kept_current, or the kept app differs from the build before's; its job is booted out and in, never kickstarted"
  else
    echo "would keep no native Bridge — $src has no crates/bridge-native"
  fi
  if [[ "$(ipc_built_protocol)" != "" && "$(ipc_built_protocol)" != "$(tree_protocol)" ]]; then
    echo "would touch $src/crates/ipc/build.rs — ipc was last built at protocol $(ipc_built_protocol) and the wire files hash to $(tree_protocol)"
  fi
  if pocket_stale; then echo "would build the phone app in $src: $(pocket_build_cmd)"; else echo "would not build the phone app — unchanged since its last build"; fi
  echo "would copy $src/apps/pocket/dist to $pocket_app (a fresh folder swapped in by rename)"
  if [[ -f "$pocket_plist" ]]; then
    echo "would boot $pocket_service out if it is loaded and delete $pocket_plist: Fleet serves the phone itself"
  fi
  echo "would copy $src/plugins to $support/mod (scripts/sync-mod)"
  if command -v claude >/dev/null 2>&1; then
    echo "would run claude plugin marketplace update armada-local, then claude plugin update armada@armada-local; a failed update is one warning and the restart goes on"
  else
    echo "WARNING: claude is not on PATH, so the installed armada plugin would not be updated"
  fi
  echo "would write $support/restart-source: $src"
  if $adopt; then
    if adopted=$( ( refuse_if_drone_working ) 2>&1 ); then
      printf '%s\n' "$adopted"
      if [[ "$adopted" == *"Adopting every working Drone"* ]]; then
        echo "--adopt: the working Drones above would be adopted and the refusal skipped"
      else
        echo "--adopt: no Drone is working, so there is nothing to skip"
      fi
    else
      printf '%s\n' "$adopted"
      echo "with --adopt the restart would still refuse: the roster did not answer"
    fi
  elif ( refuse_if_drone_working ) >/dev/null 2>&1; then
    echo "no Drone is working, so the restart would go ahead"
  else
    echo "a Drone is working or Fleet did not answer, so the restart would refuse; run without --dry-run for which"
  fi
  exit 0
fi

# **`--keep-only` builds and keeps, and touches nothing that runs**: no Drone
# is stopped, so none is waited for, and the CLI, the mod and the phone app are
# left for the swap. `docs/practices/running-locally.md`, *Kept builds*.
$keep_only || refuse_if_drone_working

# Rebuild.
built_protocol=$(ipc_built_protocol)
if [[ -n "$built_protocol" && "$built_protocol" != "$(tree_protocol)" ]]; then
  say "ipc was last built at protocol $built_protocol and the wire files in $src hash to $(tree_protocol) — touching its build script so cargo rebuilds ipc"
  touch "$src/crates/ipc/build.rs"
fi
if $keep_only; then
  say "Building armada from $src"
  (cd "$src" && cargo build --profile installed --locked -p armada --bin armada)
  armada_bin="$src/target/installed/armada"
else
say "Installing armada from $src"
(cd "$src" && cargo install --path crates/armada --profile installed --locked)

# The Claude Code mod rides with the build: Fleet's own copy, which the
# owner's plugin install points at, is refreshed from the tree just built.
# A missing source warns and does not stop the restart.
say "Copying the Claude Code mod from $src"
"$root/scripts/sync-mod" "$src"

# **A terminal job loads the plugin the CLI cached, not the copy**, and the cache
# moves only on these two commands, so a person would otherwise run them before
# `/reload-plugins` brought the new mod in. A hosted job loads the copy itself and
# needs neither. A CLI that is not on PATH or an update that fails is one warning:
# a restart is not worth refusing over a plugin.
say "Updating the installed armada plugin"
if ! command -v claude >/dev/null 2>&1; then
  echo "restart: warning: claude is not on PATH, so the installed armada plugin was not updated" >&2
elif ! { claude plugin marketplace update armada-local && claude plugin update armada@armada-local; } >&2; then
  echo "restart: warning: claude could not update the installed armada plugin, so terminal jobs keep the mod they have" >&2
fi
fi

# **A stamp this script writes, not a build output's own mtime.** A first
# attempt compared source files against `out/main/index.js`, and every build
# leaves `out/preload/index.js` and `out/renderer/**` newer than that one file
# — so the "did anything change" question always answered yes, on a tree that
# had not moved since the previous run.
#
# **The stamp's value is when the build started, and it is written when the
# run stops being able to vouch for Bridge running it.** Both matter, and
# each fixes its own incident. On 12 Sep a run built Bridge, stamped it right
# there, and then failed at the late Drone check before Fleet or Bridge were
# touched: the old process kept running, but the stamp said it was current,
# so nothing later reopened it — the *write* is deferred to wherever this
# script finishes deciding whether the running Bridge matches the build:
# after a successful reopen, or after deciding none was needed. Separately,
# `pnpm build` can run for minutes, and a source file edited while it runs
# is newer than "now" once the run finally ends — stamping "now" there would
# mark this run as covering an edit it never saw. `bridge_pending` is
# touched immediately before the build starts, so its mtime is the instant
# this run stopped being able to vouch for anything past it; that mtime, not
# "now", is what is later renamed into the stamp — `mv` carries a file's
# mtime with it.
bridge_stamp="$src/apps/desktop/out/.armada-restart-stamp"
bridge_pending="$src/apps/desktop/out/.armada-restart-stamp.pending"
bridge_rebuilt=false
# **A different source than the running Bridge was built from is a rebuild**
# whatever the stamp says: the stamp is per tree, and the window open is the
# other tree's. Only a `--from` run leaves the record, and the next plain run
# removes it, so a machine that never uses `--from` never has one.
source_record="$support/restart-source"
if [[ -n "$from" && "$(cat "$source_record" 2>/dev/null || true)" != "$src" ]]; then
  bridge_rebuilt=true
elif [[ -z "$from" && -f "$source_record" ]]; then
  bridge_rebuilt=true
elif [[ ! -f "$bridge_stamp" ]]; then
  bridge_rebuilt=true
elif bridge_protocol_stale; then
  bridge_why="it was built for another protocol than $(tree_protocol)"
  bridge_rebuilt=true
else
  changed=$(find "$src/apps" "$src/packages" -type f \
      -not -path '*/node_modules/*' \
      -not -path "$src/apps/desktop/out/*" \
      -not -path "$src/apps/desktop/release/*" \
      -not -name '*.tsbuildinfo' \
      -newer "$bridge_stamp" -print 2>/dev/null | head -n 1 || true)
  # **`|| true`, because `head` closing the pipe is the point.** With more than
  # one file changed, `find` dies of SIGPIPE once `head` has its line, and under
  # `pipefail` that is exit 141: `set -e` then ended the whole restart right
  # after the install, silently, with Fleet untouched. Confirmed 30 Sep 2026.
  [[ -n "$changed" ]] && bridge_rebuilt=true
fi

if $bridge_rebuilt; then
  say "Building Bridge — ${bridge_why:-apps/ or packages/ moved since its last build}"
  mkdir -p "$src/apps/desktop/out"
  touch "$bridge_pending"
  (cd "$src" && pnpm --filter @armada/desktop build)
else
  say "Bridge is unchanged since its last build"
fi

# **The native Bridge, built before Fleet is stopped**, so a build that fails stops the restart
# with everything still running, as Bridge's does. The stamp is written once the build took, from a
# file touched before it started, so an edit made while cargo ran still reads as newer. The
# target directory is named, so a `CARGO_TARGET_DIR` in the environment cannot move the binary.
native_arg=""
if native_present; then
  if native_stale; then
    say "Building the native Bridge — $native_why"
    mkdir -p "$native_dir/target/release"
    tree_protocol >"$native_pending"
    (cd "$src" && cargo build --release --manifest-path crates/bridge-native/Cargo.toml --target-dir crates/bridge-native/target)
    [[ -f "$native_binary" ]] || fail "cargo built the native Bridge but $native_binary is not there"
    mv -f "$native_pending" "$native_stamp"
  else
    say "The native Bridge is unchanged since its last build"
  fi
  native_arg="$native_binary"
fi

# The phone app, so the Gateway serves the tree it is restarted onto. Built on
# every Mac, opted in or not: Bridge's Phone access switch starts the Gateway
# without a restart, and it must find an app to serve when it does.
if $keep_only; then
  :
elif pocket_stale; then
  say "Building the phone app — apps/pocket or packages/ moved since its last build"
  (cd "$src" && $(pocket_build_cmd))
  mkdir -p "$src/apps/pocket/dist" && touch "$pocket_stamp"
  say "Copying the phone app to $pocket_app"
  install_pocket_app
else
  say "The phone app is unchanged since its last build"
  if [[ ! -d "$pocket_app" ]]; then
    say "Copying the phone app to $pocket_app — it was not there"
    install_pocket_app
  fi
fi

# Refuse again, fresh, right before Fleet is touched — see the comment on
# `refuse_if_drone_working` above. This is also the read `old_pid`/`old_port`
# below are taken from; the one before the rebuild is not reused; a build can
# run for minutes and Fleet's own state is not this script's to assume.
$keep_only || refuse_if_drone_working

# **Keep the build, then run it from where it is kept.** Launchd runs Fleet and
# Bridge through `$support/builds/current`, so `scripts/keep-build` has the
# build copied out of this tree (which the next restart rebuilds in place) before
# either job is touched, and `current` flips to it here. `armada build revert`
# flips the links back and reboots the two jobs; it never builds. What was kept
# and how is `scripts/keep-build`'s own header.
#
# The old build's Bridge key is read first: `point` moves `current` off it.
kept_source=main
[[ -n "$from" ]] && kept_source=preview
old_bridge_key=$(sed -n 's/^bridge = "\(.*\)"$/\1/p' "$kept_current/build.toml" 2>/dev/null || true)
old_bridge_shell=$(sed -n 's/^bridge_shell = "\(.*\)"$/\1/p' "$kept_current/build.toml" 2>/dev/null || true)
old_electron=$(sed -n 's/^electron = "\(.*\)"$/\1/p' "$kept_current/build.toml" 2>/dev/null || true)
old_native_key=$(sed -n 's/^native = "\(.*\)"$/\1/p' "$kept_current/build.toml" 2>/dev/null || true)
old_page_reload=$(sed -n 's/^page_reload = \(.*\)$/\1/p' "$kept_current/build.toml" 2>/dev/null || true)
kept_build=$("$root/scripts/keep-build" make "$src" "$armada_bin" "$kept_source" "$(tree_protocol)" ${native_arg:+"$native_arg"}) \
  || fail "could not keep the build from $src"
say "Keeping the build in $kept_build"
# **Rehearse before anything stops**: the new build opens a copy of the store,
# so one that cannot is turned away while the running Fleet is still up.
"$kept_build/armada" build rehearse || fail "the new build could not open a copy of the store, so nothing was swapped"
if $keep_only; then
  # What `armada build swap` moves onto when the person presses Swap.
  printf '%s\n' "$(basename "$kept_build")" >"$support/snapshot.tmp" && mv "$support/snapshot.tmp" "$support/snapshot"
  say "Kept $kept_build and swapped nothing"
  exit 0
fi
"$root/scripts/keep-build" point "$kept_build" || fail "could not point $kept_current at $kept_build"
new_bridge_key=$(sed -n 's/^bridge = "\(.*\)"$/\1/p' "$kept_build/build.toml" 2>/dev/null || true)
new_bridge_shell=$(sed -n 's/^bridge_shell = "\(.*\)"$/\1/p' "$kept_build/build.toml" 2>/dev/null || true)
new_electron=$(sed -n 's/^electron = "\(.*\)"$/\1/p' "$kept_build/build.toml" 2>/dev/null || true)
new_native_key=$(sed -n 's/^native = "\(.*\)"$/\1/p' "$kept_build/build.toml" 2>/dev/null || true)

# A copy of the database the new build is about to open, so a migration that
# goes wrong is recoverable. `.backup` is SQLite's own online copy and is safe
# while Fleet writes. Only `--from` runs, which are the ones that can bring in a
# migration `main` has not shipped.
if [[ -n "$from" && -f "$support/armada.db" ]]; then
  mkdir -p "$backups"
  snapshot="$backups/armada-$(date -u +%Y%m%dT%H%M%SZ).db"
  sqlite3 "$support/armada.db" ".backup '$snapshot'" || fail "could not snapshot $support/armada.db to $snapshot"
  say "Snapshot of the database: $snapshot"
  ls -1t "$backups"/armada-*.db 2>/dev/null | tail -n +6 | while IFS= read -r old; do rm -f "$old"; done
fi

# Restart Fleet under launchd.
#
# **Two Fleets is stopping a stray one by the pid the runtime file names, never
# by name.** `scripts/dev` reasons about the same incident (Storybook, ports
# 6006-6009) in `.claude/skills/armada-local/SKILL.md`. A Fleet already running
# under *our own* launchd job is left alone here — the bootout below is what
# moves it, and stopping it first would only race launchd's own restart.
mkdir -p "$support"
already_ours=false
if launchctl print "$service" >/dev/null 2>&1; then
  loaded_pid=$(launchctl print "$service" 2>/dev/null | awk -F'= ' '/^[[:space:]]*pid = /{print $2}')
  if [[ -n "$old_pid" && "$loaded_pid" == "$old_pid" ]]; then
    already_ours=true
  fi
fi

if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null && ! $already_ours; then
  say "Stopping the Fleet in $old_pid — not ours to boot out"
  kill -TERM "$old_pid"
  for _ in $(seq 40); do
    kill -0 "$old_pid" 2>/dev/null || break
    sleep 0.25
  done
  # SIGTERM waits for the turn in flight to finish — `docs/practices/running-
  # locally.md`, Stopping Fleet — which can hold the whole Check budget. Fail
  # rather than bootstrap a second Fleet beside one that has not let go yet.
  if kill -0 "$old_pid" 2>/dev/null; then
    fail "the Fleet at pid $old_pid has not stopped yet — SIGTERM waits for its turn in flight; try again once it exits"
  fi
fi

python3 - "$plist" "$label" "$kept_current/armada" "$root" "$home" "$PATH" <<'PY'
import plistlib, sys

path, label, armada_bin, root, home, path_env = sys.argv[1:7]
plistlib.dump(
    {
        "Label": label,
        "ProgramArguments": [armada_bin, "serve", root],
        # `KeepAlive={SuccessfulExit:false}` and `ThrottleInterval` 2:
        # docs/concepts/fleet.md, Daemon lifecycle. `RunAtLoad` is left false —
        # that doc's own finding is that it is a lie in the presence of
        # `KeepAlive`, which starts the job the moment it is bootstrapped.
        "KeepAlive": {"SuccessfulExit": False},
        "ThrottleInterval": 2,
        "RunAtLoad": False,
        # Without it launchd limits the whole tree, and a run the owner starts
        # from Bridge waits behind agents' builds. Agents and their Checks clamp
        # themselves: docs/concepts/manifest.md, At what priority a Check runs.
        "ProcessType": "Interactive",
        "StandardOutPath": f"{home}/Library/Logs/Armada/{label}.log",
        "StandardErrorPath": f"{home}/Library/Logs/Armada/{label}.log",
        "EnvironmentVariables": {"HOME": home, "PATH": path_env},
    },
    open(path, "wb"),
)
PY
chmod 644 "$plist"
mkdir -p "$home/Library/Logs/Armada"

# **Boot the job out and back in; never kickstart it.** `kickstart -k` restarts
# the definition launchd already holds and ignores the plist just written, so a
# changed program path or argument was never loaded. A fresh bootstrap starts
# the job on its own — `KeepAlive` fires the moment it is loaded, regardless of
# `RunAtLoad` (fleet.md, Daemon lifecycle). Bootout is SIGTERM, which waits for
# the turn in flight, so this refuses rather than bootstrap beside a Fleet that
# has not let go.
# Before Fleet starts, so the port its Gateway binds is free.
if [[ -f "$pocket_plist" ]] || launchctl print "$pocket_service" >/dev/null 2>&1; then
  say "Retiring $pocket_service: Fleet serves the phone itself"
  launchctl bootout "$pocket_service" 2>/dev/null || true
  for _ in $(seq 40); do
    launchctl print "$pocket_service" >/dev/null 2>&1 || break
    sleep 0.25
  done
  rm -f "$pocket_plist"
fi

say "Booting $service out and back in from $plist"
if launchctl print "$service" >/dev/null 2>&1; then
  launchctl bootout "$service" 2>/dev/null || true
  for _ in $(seq 40); do
    launchctl print "$service" >/dev/null 2>&1 || break
    sleep 0.25
  done
  if launchctl print "$service" >/dev/null 2>&1; then
    fail "$service has not stopped yet — SIGTERM waits for its turn in flight; try again once it exits"
  fi
fi
launchctl bootstrap "$domain" "$plist"
loaded_program=$(launchctl print "$service" 2>/dev/null | sed -n 's/^[[:space:]]*program = //p')
if [[ "$loaded_program" != "$kept_current/armada" ]]; then
  fail "launchd loaded Fleet from ${loaded_program:-nowhere}, not $kept_current/armada — it would run the wrong build"
fi

# **A Fleet other than the old one answers `/health` within a minute, or the
# swap is undone.** `armada build settle` marks the build as one that did not
# come up and swaps back onto the build before, leaving Bridge where it is, since
# Bridge is moved below only once Fleet answers. The kept build runs it: the
# rehearsal above proved it runs.
"$kept_build/armada" build settle ${old_pid:+"$old_pid"} \
  || fail "the new Fleet did not answer, so Fleet was swapped back onto the build before — read $home/Library/Logs/Armada/$label.log"
new_pid=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["pid"])' "$runtime")

new_port=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["port"])' "$runtime")
protocol=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("protocol_id", ""))' "$runtime")

# The binary just installed must speak the protocol this tree's wire files hash
# to. A Fleet reporting another ID is a build that kept a stale `ipc`, and
# Bridge refuses to connect to it.
want_protocol=$(tree_protocol)
if [[ "$protocol" != "$want_protocol" ]]; then
  echo "restart: !!! PROTOCOL MISMATCH: the new Fleet reports $protocol and the wire files in $src hash to $want_protocol." >&2
  echo "restart: !!! ipc was built from older files. Run \`cargo clean -p ipc\` in $src and restart again." >&2
  fail "Fleet is up on protocol $protocol, not $want_protocol; Bridge was not reopened"
fi

# The commit the Fleet now running was built from, which Bridge's Fleet panel
# counts against origin/main. Written once the new Fleet speaks the right
# protocol, so a restart that failed before here leaves the old record true.
git -C "$src" rev-parse HEAD >"$support/restart-commit" 2>/dev/null || rm -f "$support/restart-commit"

# Reopen Bridge, only if it was rebuilt or is not the kept build. Otherwise it
# reconnects on its own — apps/desktop/src/main/socket.ts.
#
# **Not the kept build** is two things, neither a rebuild. A Bridge job loaded
# from anywhere but `builds/current/bridge` is the first restart onto kept
# builds, and its plist still names a tree. A `bridge` key that differs from the
# build before's is `out/` changed without this run building it. A job that is
# not loaded at all, or a first build with nothing before it to differ from, is
# not a reason: a Bridge someone started by hand is left alone as it always was.
# `bridge_rebuilt` is left as it was, because the stamp below says what *this
# run built*, and a reopen that built nothing must not vouch for an edit it never saw.
#
# **Where only the page differs**, Bridge is not reopened: the running one reloads
# its window from `builds/current` once Fleet is back
# (`apps/desktop/src/main/page-reload.ts`), which is safe only while main, preload
# and Electron are the same, and only where the running build says it can.
bridge_reopened=false
bridge_reloads=false
bridge_reopen=$bridge_rebuilt
loaded_bridge_dir=$(launchctl print "$bridge_service" 2>/dev/null | sed -n 's/^[[:space:]]*working directory = //p' || true)
if [[ -n "$loaded_bridge_dir" && "$loaded_bridge_dir" != "$kept_current/bridge" ]]; then
  say "Bridge runs from $loaded_bridge_dir, not the kept build — reopening it there"
  bridge_reopen=true
elif [[ -n "$old_bridge_key" && "$old_bridge_key" != "$new_bridge_key" ]]; then
  if [[ "$old_page_reload" == true && -n "$old_bridge_shell" && "$old_bridge_shell" == "$new_bridge_shell" && "$old_electron" == "$new_electron" ]]; then
    say "Only Bridge's page differs from the build before's — Bridge reloads it in place"
    bridge_reopen=false
    bridge_reloads=true
  else
    say "Bridge's files differ from the build before's — reopening it"
    bridge_reopen=true
  fi
fi
if $bridge_reopen; then
  # **Quit the running Bridge by a handle proven to be this repository's,
  # never by name.** The owner's Bridge today is as likely to be a plain
  # `electron-vite preview` from `scripts/dev` in his terminal as anything
  # this script started, so there is no service to kickstart in place. What
  # is provable without guessing: Electron's own binary lives under this
  # repository's `node_modules`, nowhere else, so a process running exactly
  # that binary with no arguments but `.` is this repository's Bridge and
  # nothing else's — a path match, not a name pattern. Exactly one match is
  # quit by its pid; more than one, or one that will not quit, is left alone
  # and reported rather than guessed at.
  bridge_pattern="^${root}/node_modules/.*/(Electron|Armada|Armada Classic)\\.app/Contents/MacOS/(Electron|Armada|Armada Classic) \\.\$"
  # With `--from`, the window already open may be either tree's.
  [[ "$src" != "$root" ]] && bridge_pattern="^(${root}|${src})/node_modules/.*/(Electron|Armada|Armada Classic)\\.app/Contents/MacOS/(Electron|Armada|Armada Classic) \\.\$"
  # **A Bridge run from a kept build** is the binary under `$support/node_modules/`
  # given a folder of `$support/builds/`. The support folder has a space in it and
  # dots, so it is escaped for the regex.
  support_re=$(printf '%s' "$support" | sed 's/[][\\.*^$+?(){}|]/\\&/g')
  bridge_pattern="(${bridge_pattern})|(^${support_re}/node_modules/.*/(Electron|Armada|Armada Classic)\\.app/Contents/MacOS/(Electron|Armada|Armada Classic) ${support_re}/builds/[^/]+/bridge\$)"
  # **Out of launchd before any pid is quit**: a Bridge launchd holds and is
  # killed is reopened (`scripts/bridge-launch`), so it would come back old.
  if launchctl print "$bridge_service" >/dev/null 2>&1; then
    launchctl bootout "$bridge_service" 2>/dev/null || true
    for _ in $(seq 40); do
      launchctl print "$bridge_service" >/dev/null 2>&1 || break
      sleep 0.25
    done
  fi
  existing=$(pgrep -f "$bridge_pattern" 2>/dev/null || true)
  existing_count=0
  [[ -n "$existing" ]] && existing_count=$(printf '%s\n' "$existing" | grep -c .)

  reopen_ok=true
  if [[ "$existing_count" -eq 1 ]]; then
    old_bridge_pid="$existing"
    say "Quitting the running Bridge (pid $old_bridge_pid) for this repository"
    kill -TERM "$old_bridge_pid" 2>/dev/null || true
    for _ in $(seq 40); do
      kill -0 "$old_bridge_pid" 2>/dev/null || break
      sleep 0.25
    done
    if kill -0 "$old_bridge_pid" 2>/dev/null; then
      echo "restart: Bridge (pid $old_bridge_pid) did not quit in time — leaving it. Restart Bridge by hand." >&2
      reopen_ok=false
    fi
  elif [[ "$existing_count" -gt 1 ]]; then
    echo "restart: more than one Bridge window is open for this repository — not guessing which to quit. Restart Bridge by hand." >&2
    reopen_ok=false
  fi

  if $reopen_ok; then
    # **The kept build's own launcher, through `current`, not pnpm.** Nothing
    # names a tree, so the build kept above is the build run, and a flipped link
    # is all a revert needs. `launch-bridge` names the Electron it was kept with
    # (the Armada Classic copy `scripts/armada-electron` made, else Electron's own,
    # which says "Electron" in the menu bar but runs).
    bridge_dir="$kept_current/bridge"
    [[ -x "$kept_current/bridge-launch" && -x "$kept_current/launch-bridge" ]] \
      || fail "$kept_current has no executable bridge-launch and launch-bridge — the build was not kept whole"
    # **Reopened by launchd when it stops without a quit**: `scripts/bridge-launch`
    # turns a crash or a kill into exit 1, and a quit the person meant into exit 0.
    python3 - "$bridge_plist" "$bridge_label" "$bridge_dir" "$home" "$PATH" "$kept_current/bridge-launch" "$kept_current/launch-bridge" "$support/bridge-quit" <<'PY'
import plistlib, sys

path, label, root, home, path_env, launch, launch_bridge, quit_mark = sys.argv[1:9]
env = {"HOME": home, "PATH": path_env, "ARMADA_BRIDGE_QUIT_MARK": quit_mark}
plistlib.dump(
    {
        "Label": label,
        "ProgramArguments": [launch, launch_bridge],
        "WorkingDirectory": root,
        "RunAtLoad": True,
        "KeepAlive": {"SuccessfulExit": False},
        "ThrottleInterval": 10,
        "ProcessType": "Interactive",
        "StandardOutPath": f"{home}/Library/Logs/Armada/{label}.log",
        "StandardErrorPath": f"{home}/Library/Logs/Armada/{label}.log",
        "EnvironmentVariables": env,
    },
    open(path, "wb"),
)
PY
    chmod 644 "$bridge_plist"
    # **Boot the job out and back in; never kickstart it.** `kickstart -k`
    # restarts the definition launchd already holds and ignores the plist just
    # written, so a Bridge loaded from the main checkout kept running there
    # while the file on disk named the preview. Confirmed 6 Oct: the loaded job
    # said WorkingDirectory main, the plist said .armada/preview.
    say "Reopening Bridge from $bridge_dir"
    if launchctl print "$bridge_service" >/dev/null 2>&1; then
      launchctl bootout "$bridge_service" 2>/dev/null || true
      for _ in $(seq 40); do
        launchctl print "$bridge_service" >/dev/null 2>&1 || break
        sleep 0.25
      done
    fi
    launchctl bootstrap "$domain" "$bridge_plist"
    loaded_dir=$(launchctl print "$bridge_service" 2>/dev/null | sed -n 's/^[[:space:]]*working directory = //p')
    if [[ "$loaded_dir" != "$bridge_dir" ]]; then
      fail "launchd loaded Bridge from ${loaded_dir:-nowhere}, not $bridge_dir — it would show the wrong tree"
    fi
    echo "Bridge runs $bridge_dir/out (kept from $src)" >&2
    bridge_reopened=true
  fi
fi

# **The native Bridge is opened when it is not open from the kept build**, and otherwise left alone,
# so a restart that changed nothing in it does not close the window the person is using. That is:
# its job is not loaded (never opened, or the Mac restarted), is loaded from anywhere but
# `builds/current`, or the kept app differs from the build before's. A job that is loaded and
# stopped is a quit the person meant (`scripts/bridge-launch`), and stays closed unless the app changed.
native_reopened=false
if [[ -n "$new_native_key" ]]; then
  loaded_native_dir=$(launchctl print "$native_service" 2>/dev/null | sed -n 's/^[[:space:]]*working directory = //p' || true)
  native_reopen=false
  if [[ -z "$loaded_native_dir" ]]; then
    say "The native Bridge is not loaded — opening it"
    native_reopen=true
  elif [[ "$loaded_native_dir" != "$kept_current" ]]; then
    say "The native Bridge runs from $loaded_native_dir, not the kept build — reopening it there"
    native_reopen=true
  elif [[ "$old_native_key" != "$new_native_key" ]]; then
    say "The native Bridge differs from the build before's — reopening it"
    native_reopen=true
  fi
  if $native_reopen; then
    [[ -x "$kept_current/bridge-launch" && -x "$kept_current/Armada.app/Contents/MacOS/Armada" ]] \
      || fail "$kept_current has no executable bridge-launch and Armada.app — the build was not kept whole"
    # **Reopened by launchd when it stops without a quit**, through the same `bridge-launch`,
    # with a mark of its own: the app writes it on a quit the person meant (`crates/bridge-native/src/main.rs`).
    python3 - "$native_plist" "$native_label" "$kept_current" "$home" "$PATH" "$kept_current/bridge-launch" "$kept_current/Armada.app/Contents/MacOS/Armada" "$support/bridge-native-quit" <<'PY'
import plistlib, sys

path, label, root, home, path_env, launch, binary, quit_mark = sys.argv[1:9]
env = {"HOME": home, "PATH": path_env, "ARMADA_BRIDGE_QUIT_MARK": quit_mark}
plistlib.dump(
    {
        "Label": label,
        "ProgramArguments": [launch, binary],
        "WorkingDirectory": root,
        "RunAtLoad": True,
        "KeepAlive": {"SuccessfulExit": False},
        "ThrottleInterval": 10,
        "ProcessType": "Interactive",
        "StandardOutPath": f"{home}/Library/Logs/Armada/{label}.log",
        "StandardErrorPath": f"{home}/Library/Logs/Armada/{label}.log",
        "EnvironmentVariables": env,
    },
    open(path, "wb"),
)
PY
    chmod 644 "$native_plist"
    say "Reopening the native Bridge from $kept_current/Armada.app"
    if launchctl print "$native_service" >/dev/null 2>&1; then
      launchctl bootout "$native_service" 2>/dev/null || true
      for _ in $(seq 40); do
        launchctl print "$native_service" >/dev/null 2>&1 || break
        sleep 0.25
      done
    fi
    launchctl bootstrap "$domain" "$native_plist"
    loaded_native_dir=$(launchctl print "$native_service" 2>/dev/null | sed -n 's/^[[:space:]]*working directory = //p')
    if [[ "$loaded_native_dir" != "$kept_current" ]]; then
      fail "launchd loaded the native Bridge from ${loaded_native_dir:-nowhere}, not $kept_current — it would show the wrong build"
    fi
    native_reopened=true
  fi
fi

# The running Bridge now matches this build only if it was actually reopened
# onto it — not merely built. Left false (a quit that did not land, or more
# than one window open), `bridge_pending` is left where it is and the build
# already on disk stays unstamped, so the next run still finds Bridge
# changed and tries the reopen again rather than trusting a build nobody is
# running yet. Nothing needed here when Bridge was never rebuilt — the
# existing stamp already covers it, and touching it would only move its
# time later for no reason.
if $bridge_rebuilt && { $bridge_reopened || $bridge_reloads; }; then
  mkdir -p "$src/apps/desktop/out"
  if [[ -f "$bridge_pending" ]]; then
    mv -f "$bridge_pending" "$bridge_stamp"
  else
    touch "$bridge_stamp"
  fi
fi

if [[ -n "$from" ]]; then
  { $bridge_reopened || $bridge_reloads; } && printf '%s\n' "$src" > "$source_record"
  echo "Built from $src; serving $root"
elif $bridge_reopened || $bridge_reloads; then
  rm -f "$source_record"
fi

say "Done"
echo "Fleet: pid ${old_pid:-none} -> $new_pid, port $new_port, protocol $protocol"
echo "Bridge reopened: $bridge_reopened"
echo "Native Bridge reopened: $native_reopened"
# An `if`, not `&&`: as the last command, a false `&&` would be the script's exit status.
if $bridge_reloads; then
  echo "Bridge reloads its page in place"
fi

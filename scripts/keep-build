#!/usr/bin/env bash
#
# Keep the build a restart installs, so the build before it can be run again
# without compiling anything. Run by `scripts/restart`, once per restart, after
# Fleet and the native Bridge are built and before launchd is touched; `docs/practices/
# running-locally.md`, "Kept builds", says what the owner sees of it.
#
# **Launchd runs the native Bridge through `builds/current`, and Fleet from the copy of
# `current`'s bundle in `fleet/`**, so going back to the build before is two
# symlinks flipped, one bundle copied and the launchd jobs rebooted, not a rebuild. That only works if a build is a folder nothing else rewrites:
# a tree's `target/` is rebuilt in place by the next restart, and a
# worktree under `.armada/` is deleted when its branch lands.
#
#   keep-build make <src> <armada binary> <main|preview> <protocol id> [<native binary>]
#       Builds `builds/<UTC stamp>-<short commit>/` and prints its absolute path. Fleet is in it as
#       `Armada Fleet.app`, with `armada` a link to the bundled binary.
#       Touches no link. A folder is made under a temporary name and renamed into
#       place, so a half copy is never a build.
#   keep-build point <snapshot path>
#       The snapshot's `Armada Fleet.app` is copied to `fleet/Armada Fleet.app`,
#       the path launchd runs Fleet from, and its name written to `fleet/build`.
#       Then `previous` becomes the old `current` (when there was one and it is not
#       this folder), `current` becomes the snapshot, then everything past the
#       newest five builds that neither link names is deleted.
#
# **The native Bridge is kept as `Armada.app`**, when a binary is given, made by `scripts/native-app`,
# which the release makes its app with too: the cargo binary renamed to `Contents/MacOS/Armada`, an
# `Info.plist`, the brand icon, and the signature `scripts/signing-identity` gives. `native` in `build.toml` is the first 16 hex
# of one sha256 over the binary and the icon, so a restart can tell a changed app from an unchanged one. A build kept without one has no `native` line.
# **Launch Services lists current's app alone**: after pruning, `point` runs `lsregister -u` on every path
# `lsregister -dump` lists under `builds/`, deleted folders, Voice helpers and Fleet bundles included, but
# current's `Armada.app` and the running native Bridge's, then `-f` on current's and the placed Fleet. A
# notification press launches whatever bundle it still lists under the bundle id. `ARMADA_LSREGISTER` names
# another lsregister, for a test. Fleet's Revert and swap do the same (`crates/fleet/src/kept_builds.rs`).
# `native-app` also builds Armada Voice in the tree being kept when it is missing or stale.
#
# **Everything is derived from `$HOME`**, as in `scripts/restart`, so a test
# against a scratch home never reaches the owner's builds.

set -euo pipefail

home="${HOME:?HOME must be set}"
support="$home/Library/Application Support/Armada"
builds="$support/builds"
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

fail() {
  echo "keep-build: $*" >&2
  exit 1
}

# An APFS clone where the volume allows one, else a plain copy. A failed clone
# can leave half a folder behind, so the copy starts from nothing.
clone() {
  cp -c -R "$1" "$2" 2>/dev/null || { rm -rf "$2"; cp -R "$1" "$2"; }
}

making=""
cleanup() {
  [[ -n "$making" ]] && rm -rf "$making"
  return 0
}

make() {
  [[ $# -eq 4 || $# -eq 5 ]] || fail "usage: keep-build make <src> <armada binary> <main|preview> <protocol id> [<native binary>]"
  local src="$1" armada_bin="$2" source="$3" protocol_id="$4" native_bin="${5:-}"
  [[ "$source" == main || "$source" == preview ]] || fail "source is main or preview, not $source"
  [[ -f "$armada_bin" ]] || fail "$armada_bin is not a file"
  [[ -f "$src/scripts/bridge-launch" ]] || fail "$src/scripts/bridge-launch is missing"
  local icon="$src/packages/brand/macos/AppIcon.icns"
  if [[ -n "$native_bin" ]]; then
    [[ -f "$native_bin" ]] || fail "$native_bin is not a file"
    [[ -f "$icon" ]] || fail "$icon is missing"
  fi

  local commit now stamp built_at name final
  commit=$(git -C "$src" rev-parse HEAD) || fail "$src has no commit"
  now=$(python3 -c 'import datetime; n = datetime.datetime.now(datetime.timezone.utc); print(n.strftime("%Y-%m-%dT%H%M%SZ"), n.strftime("%Y-%m-%dT%H:%M:%SZ"))')
  stamp=${now% *}
  built_at=${now#* }
  name="$stamp-${commit:0:7}"
  final="$builds/$name"
  mkdir -p "$builds"
  [[ ! -e "$final" ]] || fail "$final is already kept"

  making="$builds/.making-$name.$$"
  rm -rf "$making"
  mkdir -p "$making"
  # Fleet opens Pocket's door to the network, so macOS asks it for Local Network. A program launchd runs itself
  # has its grant kept against its resolved path and signing identifier, bundle or not: eight Refreshes left eight
  # grants, one per build folder (16 Nov). So launchd never runs it from here: `point` copies this bundle to
  # `fleet/Armada Fleet.app`, one path that never changes. It stays a bundle, signed as `dev.armada.fleet`.
  # `armada` beside it is a link to the bundled binary, for every caller that names a build's `armada`. The
  # clone is signed, never the binary it came from. Only a Mac has codesign: CI runs this on Linux.
  local fleet_app="$making/Armada Fleet.app"
  mkdir -p "$fleet_app/Contents/MacOS"
  clone "$armada_bin" "$fleet_app/Contents/MacOS/armada"
  python3 - "$fleet_app/Contents/Info.plist" <<'PY'
import plistlib, sys

plistlib.dump(
    {
        "CFBundleName": "Armada Fleet",
        "CFBundleExecutable": "armada",
        "CFBundleIdentifier": "dev.armada.fleet",
        "CFBundlePackageType": "APPL",
        "CFBundleInfoDictionaryVersion": "6.0",
        # No Dock icon and no menu bar: launchd runs it, and nobody opens it.
        "LSUIElement": True,
    },
    open(sys.argv[1], "wb"),
)
PY
  ln -s "Armada Fleet.app/Contents/MacOS/armada" "$making/armada"
  if command -v codesign >/dev/null; then
    "$here/signing-identity" sign "$fleet_app" >/dev/null 2>&1 || fail "could not sign $fleet_app"
  fi
  if [[ -n "$native_bin" ]]; then
    # The kept tree's own recipe where it has one, so a preview carries that branch's `Info.plist` and not this checkout's.
    native_recipe="$here/native-app"
    [[ ! -x "$src/scripts/native-app" ]] || native_recipe="$src/scripts/native-app"
    NATIVE_APP_TREE="$src" "$native_recipe" "$native_bin" "$making" "$icon" >/dev/null
  fi
  cp "$src/scripts/bridge-launch" "$making/bridge-launch"

  python3 - "$making" "$built_at" "$commit" "$source" "$protocol_id" "$src" "$support" "$native_bin" "${icon:-}" <<'PY'
import hashlib, json, os, sys

making, built_at, commit, source, protocol_id, src, support, native_bin, icon = sys.argv[1:10]

main, jobs = commit, []
if source == "preview":
    main = None
    try:
        # `scripts/preview --keep-only` writes `snapshot-held`, leaving the running build's own.
        with open(os.path.join(support, os.environ.get("ARMADA_PREVIEW_HELD") or "preview-held")) as f:
            held = f.read().splitlines()
    except OSError:
        held = []
    # `scripts/preview` writes it before every restart, so a first line that is not this commit is another preview's.
    if held and held[0] == commit:
        main = held[1] if len(held) > 1 and held[1] else None
        jobs = [line.split("\t")[:2] for line in held[2:] if "\t" in line]

# The tree it was built from: the app run from the kept folder has no repository above it.
rows = [("built_at", built_at), ("commit", commit), ("source", source), ("tree", os.path.abspath(src))]
if main:
    rows.append(("main", main))
rows.append(("protocol_id", protocol_id))
if native_bin:
    # The unsigned binary, so a signature never makes an unchanged app look changed.
    h = hashlib.sha256()
    for path in (native_bin, icon):
        with open(path, "rb") as f:
            h.update(hashlib.sha256(f.read()).digest())
    rows.append(("native", h.hexdigest()[:16]))
text = "".join(f"{key} = {json.dumps(value)}\n" for key, value in rows)
for branch, tip in jobs:
    text += f"\n[[job]]\nbranch = {json.dumps(branch)}\ntip = {json.dumps(tip)}\n"
with open(os.path.join(making, "build.toml"), "w") as f:
    f.write(text)
PY

  mv "$making" "$final"
  making=""
  echo "$final"
}

point() {
  [[ $# -eq 1 ]] || fail "usage: keep-build point <snapshot path>"
  local snapshot="${1%/}"
  [[ -d "$snapshot" && "$(dirname "$snapshot")" == "$builds" ]] || fail "$snapshot is not a folder in $builds"
  python3 - "$builds" "$(basename "$snapshot")" "$support/fleet" <<'PY'
import os, re, shutil, subprocess, sys

builds, name, fleet = sys.argv[1:4]
KEEP = 5
FOLDER = re.compile(r"\d{4}-\d{2}-\d{2}T\d{6}Z-[0-9a-f]+")
APP = "Armada Fleet.app"


def placed(build):
    """The build's Fleet bundle copied to `fleet/Armada Fleet.app`, the one path launchd runs, and its name to `fleet/build`.

    Each file is written beside its place and renamed over it, so a running Fleet keeps the inode it was started
    from, and the binary is never rewritten in place, which macOS kills a signed binary for. A file the build's
    bundle no longer has is removed. Kept in step with `crates/fleet/src/kept_builds.rs`, `placed`.
    """
    app = os.path.join(builds, build, APP)
    if not os.path.isfile(os.path.join(app, "Contents", "MacOS", "armada")):
        sys.exit(f"keep-build: {build} keeps no {APP}, so Fleet cannot be placed from it")
    fixed = os.path.join(fleet, APP)
    wanted = set()
    for folder, _, names in os.walk(app):
        for one in names:
            rel = os.path.relpath(os.path.join(folder, one), app)
            wanted.add(rel)
            to = os.path.join(fixed, rel)
            os.makedirs(os.path.dirname(to), exist_ok=True)
            beside = f"{to}.placing"
            if os.path.lexists(beside):
                os.remove(beside)
            shutil.copy2(os.path.join(folder, one), beside, follow_symlinks=False)
            os.replace(beside, to)
    for folder, _, names in os.walk(fixed):
        for one in names:
            if os.path.relpath(os.path.join(folder, one), fixed) not in wanted:
                os.remove(os.path.join(folder, one))
    with open(os.path.join(fleet, ".build.placing"), "w") as f:
        f.write(f"{build}\n")
    os.replace(os.path.join(fleet, ".build.placing"), os.path.join(fleet, "build"))


# Before the links move, so a build that cannot be placed leaves `current` where it was.
placed(name)


def target(link):
    try:
        return os.readlink(os.path.join(builds, link))
    except OSError:
        return None


def replace(link, to):
    # A symlink made under another name and renamed over the old one, so the link is never missing.
    temporary = os.path.join(builds, f".{link}.tmp")
    if os.path.lexists(temporary):
        os.remove(temporary)
    os.symlink(to, temporary)
    os.replace(temporary, os.path.join(builds, link))


old = target("current")
if old is not None and old != name:
    replace("previous", old)
replace("current", name)

folders = sorted(f for f in os.listdir(builds) if FOLDER.fullmatch(f) and os.path.isdir(os.path.join(builds, f)))
held = set(folders[-KEEP:]) | {target("current"), target("previous")}
for folder in folders:
    if folder not in held:
        shutil.rmtree(os.path.join(builds, folder))

# Launch Services keeps every bundle it was told of, after its folder is gone too, and a notification press or
# `open -b` can launch any one with the id. So every path it lists under `builds/` is unregistered but current's
# `Armada.app` and the bundle the running native Bridge holds its lock from, then current's `Armada.app` and the
# placed Fleet are registered. Kept in step with `crates/fleet/src/kept_builds.rs`, `launch_services_pointed`.
LSREGISTER = os.environ.get(
    "ARMADA_LSREGISTER",
    "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister",
)


def holders_bundle():
    """The `Armada.app` the running native Bridge was started from, named by its lock record, when its pid lives."""
    try:
        with open(os.path.join(os.path.dirname(builds), "bridge-native.lock")) as f:
            pid, exe = f.read().splitlines()[:2]
    except (OSError, ValueError):
        return None
    alive = subprocess.run(["ps", "-p", pid], capture_output=True).returncode == 0
    return os.path.realpath(os.path.dirname(os.path.dirname(os.path.dirname(exe)))) if alive else None


def stale(dump, within, keep):
    """Every path in an `lsregister -dump` under `within`, but those at or inside a `keep` bundle."""
    paths = re.findall(r"^path:\s+(.+?) \(0x[0-9a-f]+\)$", dump, re.M)
    return sorted({
        path for path in paths
        if path.startswith(within + "/") and not any(path == k or path.startswith(k + "/") for k in keep)
    })


if os.path.exists(LSREGISTER):
    current = os.path.join(os.path.realpath(os.path.join(builds, "current")), "Armada.app")
    keep = [current] + [b for b in [holders_bundle()] if b]
    dump = subprocess.run([LSREGISTER, "-dump"], capture_output=True, text=True, check=False).stdout
    for path in stale(dump, os.path.realpath(builds), keep):
        subprocess.run([LSREGISTER, "-u", path], capture_output=True, check=False)
    for bundle in (current, os.path.join(fleet, APP)):
        if os.path.isdir(bundle):
            subprocess.run([LSREGISTER, "-f", bundle], capture_output=True, check=False)
PY
}

trap cleanup EXIT
trap 'exit 1' INT TERM HUP

case "${1:-}" in
  make) shift; make "$@" ;;
  point) shift; point "$@" ;;
  *) fail "usage: keep-build make <src> <armada binary> <main|preview> <protocol id> | keep-build point <snapshot path>" ;;
esac

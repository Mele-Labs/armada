#!/usr/bin/env python3
#
# Move the running Fleet and Bridge onto `main` or the preview, and keep a record
# Fleet can read back. Started by Fleet's `change_fleet_build`, detached and
# unmarked so it outlives the Fleet it stops; run by hand it does the same.
#
#   scripts/restart-build main [--adopt]      scripts/restart --main
#   scripts/restart-build preview [--adopt]   scripts/preview --restart
#   scripts/restart-build snapshot            scripts/preview --restart --keep-only --picked Armada/preview-picked
#
# Two Macs on one preview build:
#
#   scripts/restart-build preview [--adopt] --push-as <name>
#       scripts/preview --restart --push-as <name>: the merged preview commit is also pushed
#       to `preview/<name>` on origin before the restart
#   scripts/restart-build preview [--adopt] --push-as <name> --tell <mac>
#       the merge and the push first, with no restart; then the local Fleet is told, with a POST
#       to `/macs/update` of {mac, build: "preview", commit, ref}, that <mac> builds that commit;
#       then `scripts/preview --restart --at <commit> --ref preview/<name>`, so this Mac builds the
#       same commit with no second merge. A failed push or POST is written to the log and the
#       restart goes on; a failed merge is the run's failure.
#   scripts/restart-build preview [--adopt] --at <sha> --ref <ref>
#       the other Mac's side: scripts/preview --restart --at <sha> --ref <ref>, which builds
#       exactly that commit and merges nothing
#
# `main` and `snapshot` take none of `--push-as`, `--tell`, `--at` and `--ref`.
#
# A snapshot is built and kept and swaps nothing, so it keeps its own record,
# `Armada/snapshot.status`, and log, `snapshot.log`; on success
# `scripts/restart` has written `Armada/snapshot`, the kept build's name.
#
# `docs/practices/running-locally.md`, "Restarting from Bridge", is what it
# leaves behind and what reads it. In short: `Armada/restart-build.status` says
# `running` and, on its third line, the stage it has reached, or `failed` with
# one line of why, and no file means it took. A stage is read off the bold
# headings the scripts print, as they print them. Output goes to
# `~/Library/Logs/Armada/restart-build.log`. The line of why is the compiler's
# first error of the last run with its file, else the last thing a script said
# other than preview's `restart exited N`, which names no cause.
#
# **A `libsqlite3-sys` build failure is run once more after
# `cargo clean -p libsqlite3-sys` in the tree that was built.** It is a stale
# build script, not the code, and Fleet is still up when it happens. Confirmed
# 6 and 7 Oct 2026; `.claude/skills/preview-app/SKILL.md`.
#
# **A failure that names rustc's incremental cache is run once more after the
# native app's `incremental` directory is removed.** The preview builds that app
# with an incremental cache, and a build killed in the middle can leave one
# rustc cannot read. The strings are rustc's own: `incremental compilation`,
# `dep graph` or `dep-graph`, and `unstable fingerprints`.
#
# Knobs for tests: `ARMADA_RESTART_SCRIPT` and `ARMADA_PREVIEW_SCRIPT` name the
# scripts this runs, `HOME` moves the record and the log,
# `ARMADA_RESTART_POLL` is how often, in seconds, the log is read for a stage, and
# `ARMADA_FLEET_URL` is the Fleet `--tell` posts to, else the port in `Armada/fleet.json`.

import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request

STALE = "libsqlite3-sys"
INCREMENTAL = re.compile(r"incremental compilation|dep[- ]graph|unstable fingerprints", re.I)
INCREMENTAL_DIR = os.path.join("crates", "bridge-native", "target", "release", "incremental")
ANSI = re.compile(r"\x1b\[[0-9;]*m")
SAID = re.compile(r"^(?:restart|preview): (?:!!! )?(.*)$")
# What `scripts/preview` says last when `scripts/restart` failed: no cause in it.
WRAPPER = re.compile(r"^restart exited \d+$")
# A compiler's own complaint (rustc, tsc), and the `-->` line that places a rustc one.
COMPILER = re.compile(r"^(?:error(?:\[\w+\])?:|.*\berror TS\d+:)")
PLACE = re.compile(r"^--> (\S+)")
LIMIT = 200

# The stage each bold heading puts the restart in. Matched against the raw line,
# so cargo's own coloured output is never mistaken for one. A heading that is not
# here leaves the stage as it was.
HEADINGS = [
    (re.compile(r"^\x1b\[1mFast-forwarding main"), "fetching_main"),
    (re.compile(r"^\x1b\[1m(?:Installing|Building) armada from"), "building_fleet"),
    (re.compile(r"^\x1b\[1mBuilding (?:the native )?Bridge"), "building_bridge"),
    (re.compile(r"^\x1b\[1m(?:Snapshot of the database|Stopping the Fleet in|Booting )"), "restarting_fleet"),
    (re.compile(r"^\x1b\[1m(?:Quitting the running Bridge|Reopening (?:the native )?Bridge from)"), "reopening_bridge"),
]
# What a second run, after the stale build script is cleaned, does not step back to.
BEFORE_BRIDGE = ("fetching_main", "building_fleet")


def write_atomically(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = path + ".tmp"
    with open(temporary, "w") as f:
        f.write(text)
    os.replace(temporary, path)


def one_line(log):
    """Why it stopped, from the end of the log: the compiler's first error of
    the last run with the file it names, else the last line a script said for
    itself (not preview's `restart exited N` when an earlier one says more),
    else the last line at all."""
    lines = [ANSI.sub("", line).strip() for line in log.splitlines()]
    lines = [line for line in lines if line]
    # An earlier run's errors were retried; only the last run's can be why it stopped.
    last_run = max((i for i, line in enumerate(lines) if line.startswith("$ ") and "cargo clean" not in line), default=-1)
    lines = lines[last_run + 1:]
    for i, line in enumerate(lines):
        if COMPILER.match(line):
            place = next((m.group(1) for m in map(PLACE.match, lines[i + 1:i + 4]) if m), "")
            suffix = f" ({place})" if place else ""
            return line[:LIMIT - len(suffix)] + suffix
    said = [m.group(1) for m in map(SAID.match, lines) if m and m.group(1)]
    for text in reversed(said):
        if not WRAPPER.match(text):
            return text[:LIMIT]
    if said:
        return said[-1][:LIMIT]
    return lines[-1][:LIMIT] if lines else "exited without output"


USAGE = ("usage: scripts/restart-build main [--adopt] | preview [--adopt] [--push-as NAME [--tell MAC]] "
         "| preview [--adopt] --at SHA --ref REF | snapshot")
TAKES_VALUE = ("--push-as", "--tell", "--at", "--ref")


def parse(args):
    """(build, adopt, {flag: value}) or an exit with the usage line."""
    if not args or args[0] not in ("main", "preview", "snapshot"):
        sys.exit(USAGE)
    build, adopt, given, rest = args[0], False, {}, iter(args[1:])
    for a in rest:
        if a == "--adopt" and not adopt:
            adopt = True
        elif a in TAKES_VALUE and a not in given:
            value = next(rest, "")
            if not value or value.startswith("-"):
                sys.exit(f"restart-build: {a} takes a value\n{USAGE}")
            given[a] = value
        else:
            sys.exit(USAGE)
    if build == "snapshot" and (adopt or given):
        sys.exit(USAGE)
    if build == "main" and given:
        sys.exit(f"restart-build: {' '.join(given)} is for preview, not main\n{USAGE}")
    if "--tell" in given and "--push-as" not in given:
        sys.exit(f"restart-build: --tell needs --push-as, the ref it tells the other Mac to fetch\n{USAGE}")
    if ("--at" in given) != ("--ref" in given):
        sys.exit(f"restart-build: --at and --ref go together\n{USAGE}")
    if "--at" in given and ("--push-as" in given or "--tell" in given):
        sys.exit(f"restart-build: --at is the Mac that builds a pushed commit; it cannot push or tell\n{USAGE}")
    return build, adopt, given


def tell(log_path, support, mac, commit, ref):
    """Tell the local Fleet that `mac` builds `commit` from `ref`. Nothing here fails the run:
    what goes wrong is written to the log, and this Mac builds the commit all the same."""
    body = json.dumps({"mac": mac, "build": "preview", "commit": commit, "ref": ref}).encode()
    try:
        base = os.environ.get("ARMADA_FLEET_URL")
        if not base:
            with open(os.path.join(support, "fleet.json")) as f:
                base = f"http://127.0.0.1:{json.load(f)['port']}"
        request = urllib.request.Request(base.rstrip("/") + "/macs/update", data=body, method="POST",
                                         headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(request, timeout=10):
            pass
        said = f"restart-build: told {mac} to build {commit[:10]} from {ref}"
    except (OSError, ValueError, KeyError) as why:
        said = f"restart-build: could not tell {mac} about {commit[:10]}: {why}"
    with open(log_path, "a") as log:
        log.write(said + "\n")


def main():
    build, adopt, given = parse(sys.argv[1:])

    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    home = os.path.expanduser("~")
    support = os.path.join(home, "Library", "Application Support", "Armada")
    kind = "snapshot" if build == "snapshot" else "restart-build"
    status = os.path.join(support, f"{kind}.status")
    log_path = os.path.join(home, "Library", "Logs", "Armada", f"{kind}.log")
    os.makedirs(os.path.dirname(log_path), exist_ok=True)

    def commit_now():
        try:
            with open(os.path.join(support, "restart-commit")) as f:
                return f.read().strip()
        except OSError:
            return ""

    def failed(why):
        write_atomically(status, f"failed\n{build}\n{commit_now()}\n{why}\n")
        print(f"restart-build: {why}", file=sys.stderr)
        return 1

    stage = None

    def enter(next_stage):
        nonlocal stage
        if next_stage != stage:
            stage = next_stage
            write_atomically(status, f"running\n{build}\n{stage}\n")

    # Preview merges before it says anything; main's first step is its fast-forward.
    enter("merging" if build == "preview" else "fetching_main")

    if build == "main":
        branch = subprocess.run(
            ["git", "-C", root, "branch", "--show-current"], capture_output=True, text=True
        ).stdout.strip()
        if branch != "main":
            return failed(f"the checkout is on {branch or 'no branch'}, not main")
        command = [os.environ.get("ARMADA_RESTART_SCRIPT") or os.path.join(root, "scripts", "restart"), "--main"]
        tree = root
    else:
        preview = os.environ.get("ARMADA_PREVIEW_SCRIPT") or os.path.join(root, "scripts", "preview")
        command = [preview, "--restart"]
        if build == "snapshot":
            command += ["--keep-only", "--picked", os.path.join(support, "preview-picked")]
        if "--at" in given:
            command += ["--at", given["--at"], "--ref", given["--ref"]]
        elif "--push-as" in given and "--tell" not in given:
            command += ["--push-as", given["--push-as"]]
        tree = os.path.join(root, ".armada", "preview")
    if adopt:
        command.append("--adopt")

    poll = float(os.environ.get("ARMADA_RESTART_POLL") or 0.5)

    def run(retrying=False):
        """Run the command with its output in the log, and follow the log for stages."""
        with open(log_path, "a") as log:
            log.write(f"$ {' '.join(command)}\n")
            log.flush()
            seen = log.tell()
            # Already in a session of its own, so `scripts/preview` and `scripts/restart` do not detach again.
            process = subprocess.Popen(command, cwd=root, stdout=log, stderr=subprocess.STDOUT,
                                       env={**os.environ, "ARMADA_RESTART_DETACHED": "1"})
            held = b""
            while True:
                finished = False
                try:
                    process.wait(timeout=poll)
                    finished = True
                except subprocess.TimeoutExpired:
                    pass
                with open(log_path, "rb") as f:
                    f.seek(seen)
                    fresh = f.read()
                seen += len(fresh)
                lines = (held + fresh).split(b"\n")
                held = lines.pop()
                for line in lines:
                    text = line.decode("utf-8", "replace")
                    for heading, reached in HEADINGS:
                        if heading.match(text):
                            if not (retrying and reached in BEFORE_BRIDGE):
                                enter(reached)
                            break
                if finished:
                    return process.returncode

    open(log_path, "w").close()
    if "--tell" in given:
        # Merge and push with no restart, tell the other Mac, then build the very commit that went.
        ref = f"preview/{given['--push-as']}"
        merge = [preview, "--push-as", given["--push-as"]]
        with open(log_path, "a") as log:
            log.write(f"$ {' '.join(merge)}\n")
            log.flush()
            merged = subprocess.run(merge, cwd=root, stdout=log, stderr=subprocess.STDOUT, env=os.environ)
        with open(log_path) as f:
            said = f.read()
        if merged.returncode != 0:
            return failed(one_line(said))
        sha = subprocess.run(["git", "-C", tree, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
        if not sha:
            return failed(f"the preview at {tree} has no commit to tell {given['--tell']} about")
        if re.search(rf"^preview: pushed .* to {re.escape(ref)}$", said, re.M):
            tell(log_path, support, given["--tell"], sha, ref)
        else:
            with open(log_path, "a") as log:
                log.write(f"restart-build: not telling {given['--tell']}: {ref} was not pushed\n")
        command[2:2] = ["--at", sha, "--ref", ref]
    code = run()
    with open(log_path) as f:
        log = f.read()
    cache = os.path.join(tree, INCREMENTAL_DIR)
    stale = STALE in log
    broken = INCREMENTAL.search(log) and os.path.isdir(cache)
    if code != 0 and (stale or broken) and os.path.isdir(tree):
        with open(log_path, "a") as f:
            if stale:
                f.write(f"\n$ cargo clean -p {STALE}  (in {tree})\n")
            if broken:
                f.write(f"\n$ rm -rf {cache}\n")
            f.flush()
            enter("retrying")
            if stale:
                subprocess.run(["cargo", "clean", "-p", STALE], cwd=tree, stdout=f, stderr=subprocess.STDOUT)
            if broken:
                shutil.rmtree(cache, ignore_errors=True)
        code = run(retrying=True)
        with open(log_path) as f:
            log = f.read()
    if code != 0:
        return failed(one_line(log))
    try:
        os.remove(status)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())

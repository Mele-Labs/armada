#!/usr/bin/env python3
"""Break long markdown prose lines at sentence ends, one sentence per line.

Rendering is unchanged: markdown joins the lines of a paragraph. Only lines
over LONG chars are touched; tables, fences, headings, HTML and indented
blocks are left alone. A break is made only outside code spans, links and
emphasis, so nothing a gate parses on one line is split.

usage: scripts/sentences [--check] FILE...

--check rewrites nothing, names each file that would change, and exits 1 if any would.
Why: an agent greps and reads by line, and a 6,000-character paragraph on one
line comes back whole for every hit in it.
"""
import re
import sys

LONG = 200
ABBREV = re.compile(r"(?:\b(?:e\.g|i\.e|vs|etc|cf|No|Fig|Mr|Ms|Dr|St|approx)\.|\b[A-Z]\.|\d\.)$")
LIST = re.compile(r"^(\s*)([-*+]|\d+[.)])( +)")


def breaks(text):
    """Indices just after a sentence end where the line may break."""
    out, tick, bracket, paren, star, under = [], 0, 0, 0, 0, 0
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c == "`":
            run = len(text[i:]) - len(text[i:].lstrip("`"))
            tick = 0 if tick == run else (run if tick == 0 else tick)
            i += run
            continue
        if tick:
            i += 1
            continue
        if c == "[":
            bracket += 1
        elif c == "]":
            bracket = max(0, bracket - 1)
        elif c == "(":
            paren += 1
        elif c == ")":
            paren = max(0, paren - 1)
        elif c == "*":
            run = len(text[i:]) - len(text[i:].lstrip("*"))
            star += 1
            i += run
            continue
        elif c == "_" and (i == 0 or not text[i - 1].isalnum()) or c == "_" and i + 1 < n and not text[i + 1].isalnum():
            under += 1
        if (
            c in ".?!"
            and i + 2 < n
            and text[i + 1] == " "
            and not bracket
            and not paren
            and star % 2 == 0
            and under % 2 == 0
            and (text[i + 2].isupper() or text[i + 2] in "`*\"'(")
            and not ABBREV.search(text[: i + 1])
        ):
            out.append(i + 1)
        i += 1
    return out


def split(line):
    if len(line) <= LONG:
        return [line]
    m = LIST.match(line)
    if m:
        lead, body, indent = m.group(0), line[m.end():], " " * m.end()
    elif line.startswith("> "):
        lead, body, indent = "> ", line[2:], "> "
    elif line[:1].isspace() or line.startswith(("|", "#", "<", "---", "    ")):
        return [line]
    else:
        lead, body, indent = "", line, ""
    cuts = breaks(body)
    if not cuts:
        return [line]
    parts, start = [], 0
    for cut in cuts:
        parts.append(body[start:cut].strip())
        start = cut
    parts.append(body[start:].strip())
    parts = [p for p in parts if p]
    return [lead + parts[0]] + [indent + p for p in parts[1:]]


def rewrap(text):
    out, fenced = [], False
    for line in text.split("\n"):
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
            out.append(line)
            continue
        out.extend([line] if fenced else split(line))
    return "\n".join(out)


def main(argv):
    check = "--check" in argv
    files = [a for a in argv if a != "--check"]
    changed = 0
    for path in files:
        before = open(path, encoding="utf-8").read()
        after = rewrap(before)
        if after != before:
            changed += 1
            if check:
                print(path)
            else:
                open(path, "w", encoding="utf-8").write(after)
    print(f"{changed} file(s) {'would change' if check else 'changed'}", file=sys.stderr)
    return 1 if check and changed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

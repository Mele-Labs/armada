#!/usr/bin/env bash
#
# Prints the Electron binary Bridge is run with: a copy of Electron.app that is
# named Armada, in its plist, its folder and its executable.
#
# **macOS draws the app menu, Dock and app switcher from the bundle it
# launched**, and an unpackaged `electron-vite preview` launches Electron's own,
# so they said "Electron" (`apps/desktop/electron-builder.yml` has the
# measurement). **The plist is not enough**: the name the Dock and switcher
# read is the process's, which is the executable's file name, so a copy with
# `CFBundleName` Armada and `Contents/MacOS/Electron` still said Electron
# (31 Oct, System Events on the running Bridge). The copy is a clone on APFS, so it costs no disk and
# well under a second; its plist names Armada; and it is signed ad hoc, which
# needs no Apple certificate. It sits under `<src>/node_modules/`, so
# `scripts/restart`'s `bridge_pattern` still proves it is this repository's
# Bridge. Redone only when Electron's version changes.
#
# Used by `scripts/restart` (as `ELECTRON_EXEC_PATH`) and `scripts/dev`.
#
# Usage: scripts/armada-electron [--dry-run] <repository root>

set -euo pipefail

dry_run=false
if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=true
  shift
fi
src="${1:?usage: armada-electron [--dry-run] <repository root>}"

real=$(cd "$src/apps/desktop/node_modules/electron/dist" 2>/dev/null && pwd -P)/Electron.app
[[ -d "$real" ]] || exit 1
version=$(cat "$real/../version" 2>/dev/null || echo unknown)
dir="$src/node_modules/.cache/armada-bridge"
stamp="$dir/.stamp"
app="$dir/Armada.app"
binary="$app/Contents/MacOS/Armada"
# The version, and what was done to the copy, so a copy made before the rename is made again.
made="$version-armada-executable"
if [[ "$(cat "$stamp" 2>/dev/null || true)" != "$made" ]]; then
  $dry_run && { echo "$binary"; exit 0; }
  rm -rf "$dir"
  mkdir -p "$dir"
  cp -cR "$real" "$app" 2>/dev/null || cp -R "$real" "$app" || exit 1
  mv "$app/Contents/MacOS/Electron" "$binary" || exit 1
  plist="$app/Contents/Info.plist"
  pb=/usr/libexec/PlistBuddy
  "$pb" -c "Set :CFBundleExecutable Armada" "$plist" || exit 1
  for key in CFBundleName CFBundleDisplayName; do
    "$pb" -c "Set :$key Armada" "$plist" 2>/dev/null || "$pb" -c "Add :$key string Armada" "$plist" || exit 1
  done
  codesign --force -s - "$app" >/dev/null 2>&1 || exit 1
  echo "$made" >"$stamp"
fi
echo "$binary"

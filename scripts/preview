#!/usr/bin/env python3
#
# A rolling preview: every in-flight branch merged on top of `main`, in a
# worktree of its own, with no Checks, so work that has not landed can be used
# while agents land it. `docs/practices/running-locally.md`, "A preview of
# unlanded work", is what it does and what it never promises.
#
#   scripts/preview                      merge once, print the table
#   scripts/preview --only a --skip b    a branch list is repeatable or comma-separated
#   scripts/preview --watch [seconds]    merge again when a branch or main moves (60)
#   scripts/preview --restart [--dry-run] [--adopt]  then `scripts/restart --from .armada/preview`
#   scripts/preview --restart --keep-only --picked <file>  build and keep main plus the branches
#       the file names, one a line, and swap nothing; an empty file is main alone
#
# **The merges are built on the side and the worktree moves once.** Each branch
# is merged into the last merge commit with `git merge-tree`, and the worktree
# lands on the final commit at the end, so git rewrites only files whose content
# differs from the last preview. Their mtimes stay, and the builds that compare
# mtimes against a stamp have nothing to restart for.
#
# **What a restart cannot take is left out, and it goes again until it builds.**
# A failed `--restart` drops the branches its output names: the migration
# guard's `leave out <branch>: <why>` lines, else the branches that changed a
# file the compiler errors name (git merges branches cut before a deletion
# without a word), else the branches that removed a module file or a crate item
# the Rust errors say is missing, in a file they did not touch. The rest are
# merged again and `scripts/restart` run again.
# A failure that names no branch still merged is reported as it is. Before each
# restart, `Armada/preview-left-out` records the commit and why each was skipped, and
# `Armada/preview-held` the main commit the preview stands on and the branches merged into it.
#
# Knobs for tests: `ARMADA_LAND_ARMADA` names the `armada` to ask about
# slots, `ARMADA_PREVIEW_RESTART` the restart script `--restart` runs, and
# `ARMADA_PREVIEW_INSTALL` the command that reinstalls a refused `armada`.

import argparse
import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.request

MIGRATIONS = "crates/store/migrations"
# The numbered list a branch cut before names still carries.
OLD_MIGRATIONS = "crates/store/src/migrations.rs"
# `preview` itself and `main` are never in flight.
NEVER = ("main", "preview")
# What `git clean` keeps: the build directories, the Bridge, native Bridge and
# phone app build stamps `scripts/restart` compares sources against, the test
# list Fleet's build script writes (a recompile of Fleet when it goes), and the
# notes the owner pins from the Bridge he runs here, which the annotation layer
# writes under the checkout.
KEEP = ("/target", "node_modules", "/apps/desktop/out", "/crates/bridge-native/target",
        "/apps/pocket/dist", "/crates/fleet/src/tests/mods.inc", "/.armada/annotations")


def git(cwd, *args, check=True):
    done = subprocess.run(
        ["git", *args], cwd=cwd, capture_output=True, text=True,
        env={**os.environ, "GIT_EDITOR": "true", "GIT_TERMINAL_PROMPT": "0"},
    )
    if check and done.returncode != 0:
        sys.exit(f"preview: git {' '.join(args)} failed in {cwd}: "
                 f"{(done.stderr or done.stdout).strip()}")
    return done


def out(cwd, *args):
    return git(cwd, *args).stdout.strip()


def repo_root():
    """The main checkout: the parent of the common git directory, so the
    preview lands in one place whichever slot this is run from."""
    common = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True)
    if common.returncode != 0:
        sys.exit("preview: not inside a git repository")
    return os.path.dirname(common.stdout.strip())


def reinstall_armada(root):
    """Install `armada` from the checkout whose manifest it refused, whose code reads that manifest."""
    command = (os.environ.get("ARMADA_PREVIEW_INSTALL")
               or "cargo install --path crates/armada --profile installed --locked").split()
    print("preview: the installed armada is older than this manifest; installing it from the checkout", flush=True)
    try:
        done = subprocess.run(command, cwd=root)
    except OSError as why:
        sys.exit(f"preview: cannot run `{command[0]}` to install armada: {why}")
    if done.returncode != 0:
        sys.exit(f"preview: installing armada exited {done.returncode}")


def armada(root, *args, may_reinstall=True):
    binary = os.environ.get("ARMADA_LAND_ARMADA") or "armada"
    try:
        done = subprocess.run([binary, *args], cwd=root, capture_output=True, text=True)
    except OSError as why:
        sys.exit(f"preview: cannot run `{binary}` to ask what is in flight: {why}")
    # A key main just added refuses the binary that only this restart would replace.
    if done.returncode != 0 and may_reinstall and "is not a key Armada reads" in done.stderr + done.stdout:
        reinstall_armada(root)
        return armada(root, *args, may_reinstall=False)
    if done.returncode != 0:
        sys.exit(f"preview: `{binary} {' '.join(args)}` said: "
                 f"{(done.stderr or done.stdout).strip()}")
    return done.stdout


# A Job in one of these holds work somebody can still use or answer for.
# Anything else with a branch, `running` without a Drone included, is stranded.
STRANDED = {"killed", "completed_failed", "rejected", "superseded"}


def fleet_get(path):
    """One read of Fleet's API, or None where Fleet is not running or does not answer."""
    runtime = os.path.join(os.path.expanduser("~"), "Library", "Application Support", "Armada", "fleet.json")
    try:
        with open(runtime) as f:
            port = json.load(f)["port"]
        with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=5) as r:
            return json.load(r)
    except (OSError, ValueError, KeyError):
        return None


def job_stopped(job_id, roster):
    """Whether a Job that holds a slot has stopped. Fleet silent means not known, so no."""
    answer = fleet_get(f"/jobs/{job_id}")
    if answer is None:
        return False
    status = answer["job"]["status"]
    return status in STRANDED or (status == "running" and job_id not in roster)


def slots(root):
    """Every slot that holds a branch: (slot, path, branch, why it is stranded or None)."""
    held = []
    roster, asked = None, False
    for line in armada(root, "worktree", "--status").splitlines():
        fields = re.split(r"\s{2,}", line.strip(), maxsplit=4)
        if len(fields) < 4 or fields[1] not in ("held", "kept"):
            continue
        holder = fields[4] if len(fields) > 4 else ""
        stranded = None
        if fields[1] == "kept":
            stranded = "held by a stopped Job"
        elif (m := re.match(r"by job (\S+)", holder)):
            if not asked:
                drones, asked = fleet_get("/drones"), True
                roster = {d["job_id"] for d in drones["drones"]} if drones else None
            if roster is not None and job_stopped(m.group(1), roster):
                stranded = "held by a stopped Job"
        held.append((fields[0], fields[2], fields[3].split()[0], stranded))
    return held


def base_of(root):
    """The newer of local `main` and `origin/main`, so a checkout that has not
    pulled still previews what has landed. Local `main` wins only where it is
    ahead of the remote; a diverged pair takes the remote, which is what lands."""
    have = [ref for ref in ("refs/heads/main", "refs/remotes/origin/main")
            if git(root, "rev-parse", "--verify", "--quiet", ref, check=False).returncode == 0]
    if not have:
        sys.exit("preview: neither `main` nor `origin/main` exists")
    if len(have) == 2:
        local_is_behind = git(root, "merge-base", "--is-ancestor", have[0], have[1], check=False).returncode == 0
        local_is_ahead = git(root, "merge-base", "--is-ancestor", have[1], have[0], check=False).returncode == 0
        return have[0] if local_is_ahead and not local_is_behind else have[1]
    return have[0]


def exists(root, branch):
    return git(root, "rev-parse", "--verify", "--quiet",
               f"refs/heads/{branch}", check=False).returncode == 0


def names(values):
    return {n.strip() for v in values or [] for n in v.split(",") if n.strip()}


def in_flight(root, base, only, skip):
    """(branches oldest first, why each named one was left out, slots held)."""
    held = slots(root)
    live = {b for _, _, b, why in held if not why}
    stranded = {b: why for _, _, b, why in held if why and b not in live}
    candidates = live | set(stranded)
    notes = []
    chosen = []
    for branch in sorted(candidates):
        if branch in NEVER or not exists(root, branch):
            continue
        ahead = out(root, "rev-list", "--count", f"{base}..{branch}")
        if ahead == "0":
            continue
        if branch in skip:
            notes.append(f"{branch}: skipped by --skip")
        elif branch in stranded:
            notes.append(f"{branch}: {stranded[branch]}")
        elif only is not None and branch not in only:
            continue
        else:
            oldest = out(root, "log", "--reverse", "--format=%ct", f"{base}..{branch}").split()[0]
            chosen.append((int(oldest), branch))
    for name in sorted((only or set()) - {b for _, b in chosen}):
        if name not in skip:
            notes.append(f"{name}: named by --only, but it is not ahead of main in a slot")
    return [b for _, b in sorted(chosen)], notes, held


def migrations_in(cwd, rev):
    """The migration names at `rev`, in order. A migration is a file in
    `crates/store/migrations/`, so two branches that each add one merge; the
    same name in two files is a collision git cannot see."""
    found = []
    listed = git(cwd, "ls-tree", "--name-only", f"{rev}:{MIGRATIONS}", check=False)
    if listed.returncode == 0:
        for file in sorted(listed.stdout.split()):
            if m := re.fullmatch(r"\d{8}T\d{4}Z-([a-z0-9_]+\.[a-z0-9_.]+)\.sql", file):
                found.append(m.group(1))
    old = git(cwd, "show", f"{rev}:{OLD_MIGRATIONS}", check=False)
    inside = False
    for line in (old.stdout.splitlines() if old.returncode == 0 else []):
        if "pub const MIGRATIONS" in line:
            inside = True
        elif inside and line.strip() == "];":
            break
        elif inside and (m := re.match(r"^\s*(?:[\w]+::)*(V\d+),", line)):
            found.append(m.group(1))
    return found


def prepare(root, wt, base):
    """The preview's worktree, made on first use. Nothing in an existing one is
    touched: `settle` moves it once, to where the merges ended."""
    git(root, "worktree", "prune")
    if not os.path.isdir(os.path.join(wt, ".git")) and not os.path.isfile(os.path.join(wt, ".git")):
        if os.path.exists(wt) and os.listdir(wt):
            sys.exit(f"preview: {wt} exists and is not a worktree; remove it and run again")
        os.makedirs(os.path.dirname(wt), exist_ok=True)
        git(root, "worktree", "add", "-q", "-B", "preview", wt, base)


def settle(wt, final):
    """Land the worktree on `final` in one step. Git rewrites only the files
    whose content differs between the old preview and `final`, so a file an
    in-flight branch changes keeps its mtime when the last preview had it so,
    and the builds that compare mtimes have nothing to restart for."""
    git(wt, "merge", "--abort", check=False)
    git(wt, "reset", "-q", "--hard")
    git(wt, "checkout", "-q", "-B", "preview", final)
    git(wt, "clean", "-xdffq", *[a for k in KEEP for a in ("-e", k)])


def merge_tree(wt, cur, branch):
    """Merge `branch` into the commit `cur` without touching the worktree.
    Returns (tree, None) for a clean merge, or (None, conflicted files)."""
    done = git(wt, "merge-tree", "--write-tree", "--name-only", "--no-messages", cur, branch, check=False)
    lines = done.stdout.splitlines()
    if done.returncode == 0 and lines:
        return lines[0], None
    if done.returncode == 1 and lines:
        return None, lines[1:]
    sys.exit(f"preview: git merge-tree {cur} {branch} failed in {wt}: {(done.stderr or done.stdout).strip()}")


def merge_pass(root, only, skip, dropped=None):
    """Merge once; returns the worktree, the base and the table's rows.
    `dropped` is {branch: why}: branches a restart showed it cannot take.
    The merge commits are built on the side from `cur` and the worktree moves
    to the last of them once, at the end."""
    dropped = dropped or {}
    wt = os.path.join(root, ".armada", "preview")
    git(root, "fetch", "--quiet", "origin", check=False)
    base = base_of(root)
    prepare(root, wt, base)
    branches, notes, held = in_flight(root, base, only, skip)

    cur = out(root, "rev-parse", f"{base}^{{commit}}")
    taken = {v: "main" for v in migrations_in(wt, cur)}
    rows = []
    for branch in branches:
        if branch in dropped:
            rows.append((branch, f"skipped ({dropped[branch]})", ""))
            continue
        # A branch that merged main can have several merge bases; one alone misses main's migrations.
        before = {v for mb in out(wt, "merge-base", "--all", cur, branch).split() for v in migrations_in(wt, mb)}
        added = [v for v in migrations_in(wt, branch) if v not in before]
        clash = [(v, taken[v]) for v in added if v in taken]
        if clash:
            v, who = clash[0]
            rows.append((branch, f"skipped (migration {v} is already taken by {who})", ""))
            continue
        if git(wt, "merge-base", "--is-ancestor", branch, cur, check=False).returncode == 0:
            rows.append((branch, "nothing new", ""))
            continue
        tree, files = merge_tree(wt, cur, branch)
        if tree is None:
            rows.append((branch, "skipped (conflict: " + ", ".join(files or ["unknown"]) + ")", ""))
            continue
        cur = out(wt, "commit-tree", tree, "-p", cur, "-p", branch, "-m", f"Merge branch '{branch}' into preview")
        for v in added:
            taken[v] = branch
        rows.append((branch, "merged", out(wt, "rev-parse", "--short", cur)))

    settle(wt, cur)
    head = out(wt, "rev-parse", "--short", "HEAD")
    warnings = []
    for slot, path, branch, _ in held:
        if os.path.isdir(path):
            dirty = git(path, "status", "--porcelain", check=False).stdout.splitlines()
            if dirty:
                warnings.append(f"{slot} ({branch}) has {len(dirty)} uncommitted files, not included")
    text = render(base, out(root, "rev-parse", "--short", base), head, rows, notes, warnings)
    with open(os.path.join(wt, "PREVIEW.txt"), "w") as f:
        f.write(text)
    sys.stdout.write(text)
    sys.stdout.flush()
    return wt, base, rows


def render(base, base_sha, head, rows, notes, warnings):
    lines = [f"preview {head} = {base.split('/')[-1]} {base_sha} + in-flight branches",
             "Only committed work is included. No Checks were run.", ""]
    lines += [f"warning: {w}" for w in warnings] + [f"left out: {n}" for n in notes]
    if warnings or notes:
        lines.append("")
    if rows:
        width = max(len(r[0]) for r in rows)
        lines += [f"{b.ljust(width)}  {what}" + (f"  -> {sha}" if sha else "") for b, what, sha in rows]
    else:
        lines.append("no branch is ahead of main in a slot")
    lines += ["", f"preview head: {head}", ""]
    return "\n".join(lines)


def signature(root, only, skip):
    base = base_of(root)
    branches, _, _ = in_flight(root, base, only, skip)
    return (out(root, "rev-parse", base),
            tuple((b, out(root, "rev-parse", f"refs/heads/{b}")) for b in branches))


ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
# rustc places an error with `--> path:line:col`, under a header that says error or warning.
RUSTC_AT = re.compile(r"^\s*--> (.+?):\d+:\d+\s*$")
DIAGNOSTIC = re.compile(r"^(warning|error)\b")
# tsc says `path.ts(12,5)`; vite and esbuild say `path.ts:12:5`.
SCRIPT_AT = re.compile(r"([^\s()'\"]+\.(?:[cm]?[jt]sx?|vue|css))(?:\(\d+,\d+\)|:\d+:\d+)")
# Rollup names an import it cannot resolve by the importing file alone: `file: path`.
ROLLUP_FILE = re.compile(r"^file: (\S+?\.(?:[cm]?[jt]sx?|vue|css))(?::\d+:\d+)?\s*$")


def relative(path, wt):
    """`path` as the repo-relative path it names inside the worktree `wt`."""
    for prefix in (p + "/" for p in {wt, os.path.realpath(wt)}):
        path = path.removeprefix(prefix)
    return path.removeprefix("./")


def error_paths(output, wt):
    """The repo-relative files the compiler errors in `output` name."""
    kind, found = None, []
    for line in ANSI.sub("", output).splitlines():
        if m := DIAGNOSTIC.match(line):
            kind = m.group(1)
        if (m := RUSTC_AT.match(line)):
            if kind == "error":
                found.append(m.group(1))
        elif (m := ROLLUP_FILE.match(line)):
            found.append(m.group(1))
        else:
            found += SCRIPT_AT.findall(line)
    paths = []
    for path in found:
        path = relative(path, wt)
        if path and not path.startswith(("/", "..")) and path not in paths:
            paths.append(path)
    return paths


def does_not_build(root, base, rows, output, wt):
    """{branch: files} for the merged branches that changed a file the compiler errors name,
    whole or by its tail."""
    named = error_paths(output, wt)
    culprits = {}
    for branch, what, _ in rows:
        if what != "merged":
            continue
        touched = set(out(root, "diff", "--name-only", f"{base}...{branch}").splitlines())
        # pnpm, tsc and vite print paths relative to the package (`src/App.tsx` for
        # `apps/desktop/src/App.tsx`), so a path no branch file equals is matched by its tail.
        files = []
        for path in named:
            files += [path] if path in touched else sorted(f for f in touched if f.endswith("/" + path))
        if files:
            culprits[branch] = files
    return culprits


# What rustc says is gone, by name: a module file it looked for, an item a crate path no longer has.
MISSING_MODULE = re.compile(r"^error\[E0583\]: file not found for module `(\w+)`")
CREATE_FILE = re.compile(r'create file "([^"]+)"')
UNRESOLVED_IMPORT = re.compile(r"^error\[E0432\]: unresolved imports? (.+)$")
NOT_IN_CRATE = re.compile(r"^error(?:\[\w+\])?: cannot find [^`]+ `(\w+)` in crate `(\w+)`")
NO_ITEM = re.compile(r"^error(?:\[\w+\])?: no .*?named `(\w+)` found for \w+ `(\w+)::[^`]*`")


def missing(output, wt):
    """What the Rust errors in `output` say is missing: ([paths a module could be, erroring file],
    [item name, crate directory name, erroring file])."""
    blocks = []
    for line in ANSI.sub("", output).splitlines():
        if DIAGNOSTIC.match(line):
            blocks.append([line, None, []])
        elif blocks and blocks[-1][1] is None and (m := RUSTC_AT.match(line)):
            blocks[-1][1] = relative(m.group(1), wt)
        elif blocks and "create file" in line:
            blocks[-1][2] += [relative(p, wt) for p in re.findall(r'"([^"]+\.rs)"', line)]
    files, items = [], []
    for header, at, created in blocks:
        if not at:
            continue
        if m := MISSING_MODULE.match(header):
            here = os.path.dirname(at)
            files.append(([f"{here}/{m.group(1)}.rs", f"{here}/{m.group(1)}/mod.rs"] + created, at))
        elif m := UNRESOLVED_IMPORT.match(header):
            for path in re.findall(r"`(\w+(?:::\w+)+)`", m.group(1)):
                parts = path.split("::")
                items.append((parts[-1], parts[0].replace("_", "-"), at))
        elif m := (NOT_IN_CRATE.match(header) or NO_ITEM.match(header)):
            crate = m.group(2)
            items.append((m.group(1), crate.replace("_", "-"), at))
    return files, items


def removed_item(root, base, branch, crate, name):
    """Whether `branch` took `name` out of `crates/<crate>` and put it nowhere in that crate."""
    word = re.compile(rf"\b{re.escape(name)}\b")
    removed = added = False
    for line in out(root, "diff", "-U0", f"{base}...{branch}", "--", f"crates/{crate}").splitlines():
        if line.startswith(("---", "+++")):
            continue
        if line.startswith("-") and word.search(line):
            removed = True
        elif line.startswith("+") and word.search(line):
            added = True
    return removed and not added


def removed_by(root, base, rows, output, wt):
    """{branch: [what]} for the merged branches that removed a file or an item the Rust errors
    in `output` name and something still uses."""
    files, items = missing(output, wt)
    items = [i for i in items if git(root, "cat-file", "-e", f"{base}:crates/{i[1]}", check=False).returncode == 0]
    culprits = {}
    for branch, what, _ in rows:
        if what != "merged":
            continue
        deleted = set(out(root, "diff", "--name-only", "--diff-filter=D", f"{base}...{branch}").splitlines())
        found = [f"removed {next(p for p in paths if p in deleted)} that {at} still uses"
                 for paths, at in files if deleted.intersection(paths)]
        found += [f"removed {name} that {at} still uses"
                  for name, crate, at in items if removed_item(root, base, branch, crate, name)]
        if found:
            culprits[branch] = list(dict.fromkeys(found))
    return culprits


LEAVE_OUT = re.compile(r"^restart: leave out (\S+): (.+)$")


def write_left_out(wt, rows, name="preview-left-out"):
    """`Armada/preview-left-out`: the preview commit, then a `branch<TAB>tip<TAB>why` line for
    each branch it skipped. Once that commit is the build it runs, Fleet tells each branch's
    Job why, and refreshes the preview when a branch moves past its tip."""
    support = os.path.join(os.path.expanduser("~"), "Library", "Application Support", "Armada")
    os.makedirs(support, exist_ok=True)
    lines = [out(wt, "rev-parse", "HEAD")]
    lines += [f"{branch}\t{out(wt, 'rev-parse', f'refs/heads/{branch}')}\t{what[len('skipped ('):-1]}"
              for branch, what, _ in rows if what.startswith("skipped (")]
    path = os.path.join(support, name)
    with open(path + ".tmp", "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(path + ".tmp", path)


def write_held(root, wt, base, rows, name="preview-held"):
    """`Armada/preview-held`: the preview commit, then the main commit it stands on, then a
    `branch<TAB>tip` line for each branch merged into it. Fleet keeps these with the build, so a
    figure can be read against what the build held, and reads them only while that commit is the build."""
    support = os.path.join(os.path.expanduser("~"), "Library", "Application Support", "Armada")
    os.makedirs(support, exist_ok=True)
    lines = [out(wt, "rev-parse", "HEAD"), out(root, "rev-parse", base)]
    lines += [f"{branch}\t{out(wt, 'rev-parse', f'refs/heads/{branch}')}"
              for branch, what, _ in rows if what == "merged"]
    path = os.path.join(support, name)
    with open(path + ".tmp", "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(path + ".tmp", path)


def cannot_take(root, base, rows, output, wt):
    """{branch: why} for the merged branches this restart's output says it cannot take: the
    ones the migration guard names, else the ones that changed a file the compiler errors name,
    else the ones that removed what the Rust errors say is missing."""
    merged = {branch for branch, what, _ in rows if what == "merged"}
    guarded = {m.group(1): m.group(2) for m in map(LEAVE_OUT.match, output.splitlines()) if m}
    named = {branch: why for branch, why in guarded.items() if branch in merged}
    if named:
        return named
    culprits = does_not_build(root, base, rows, output, wt)
    if culprits:
        return {branch: "does not build: " + ", ".join(files) for branch, files in culprits.items()}
    return {branch: "does not build: " + "; ".join(what[:3]) + (f"; and {len(what) - 3} more" if len(what) > 3 else "")
            for branch, what in removed_by(root, base, rows, output, wt).items()}


def restart(root, wt, dry_run, adopt, keep_only=False):
    """Run the restart script with its output flowing on as it always did, and
    return its exit code with all it said, for the errors to be read from. A
    kept-only build reads what it held from `snapshot-held`, so the running
    build's own record is left as it is."""
    script = os.environ.get("ARMADA_PREVIEW_RESTART") or os.path.join(root, "scripts", "restart")
    command = ([script, "--from", wt] + (["--dry-run"] if dry_run else []) + (["--adopt"] if adopt else [])
               + (["--keep-only"] if keep_only else []))
    print("running " + " ".join(command), flush=True)
    env = dict(os.environ)
    if keep_only:
        env["ARMADA_PREVIEW_HELD"] = "snapshot-held"
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
    said = []

    def copy(pipe, stream):
        for line in iter(pipe.readline, b""):
            said.append(line)
            stream.buffer.write(line)
            stream.buffer.flush()

    copiers = [threading.Thread(target=copy, args=(child.stdout, sys.stdout)),
               threading.Thread(target=copy, args=(child.stderr, sys.stderr))]
    for t in copiers:
        t.start()
    code = child.wait()
    for t in copiers:
        t.join()
    print(f"scripts/restart {'would have' if dry_run else 'has'} built from {wt} and "
          f"serves the repository at {root}" if code == 0 else f"preview: restart exited {code}")
    return code, b"".join(said).decode("utf-8", "replace")


def main():
    ap = argparse.ArgumentParser(prog="scripts/preview", description=__doc__.strip() if __doc__ else None)
    ap.add_argument("--only", action="append", metavar="BRANCH", help="include only these")
    ap.add_argument("--skip", action="append", metavar="BRANCH", help="leave these out")
    ap.add_argument("--watch", nargs="?", const=60, type=int, metavar="SECONDS",
                    help="merge again when main or an included branch moves")
    ap.add_argument("--restart", action="store_true", help="then run scripts/restart --from the preview")
    ap.add_argument("--dry-run", action="store_true", help="with --restart: print, change nothing")
    ap.add_argument("--adopt", action="store_true", help="with --restart: restart Fleet with a Drone working, adopting it")
    ap.add_argument("--keep-only", action="store_true", help="with --restart: build and keep it, and swap nothing")
    ap.add_argument("--picked", metavar="FILE", help="include only the branches this file names, one a line")
    args = ap.parse_args()
    if args.watch is not None and args.restart:
        sys.exit("preview: --watch never restarts Fleet. Run --restart on its own.")
    if args.adopt and args.watch is not None:
        sys.exit("preview: --adopt is for --restart, which --watch never runs")
    if args.adopt and not args.restart:
        sys.exit("preview: --adopt is for --restart")
    if args.dry_run and not args.restart:
        sys.exit("preview: --dry-run is for --restart")
    if args.keep_only and not args.restart:
        sys.exit("preview: --keep-only is for --restart")
    if args.picked and args.only:
        sys.exit("preview: --picked and --only both name the branches; give one")
    only, skip = (names(args.only) if args.only else None), names(args.skip)
    if args.picked:
        try:
            with open(args.picked) as f:
                only = names(f.read().splitlines())
        except FileNotFoundError:
            only = set()
    root = repo_root()

    wt, base, rows = merge_pass(root, only, skip)
    if args.watch is not None:
        seen = signature(root, only, skip)
        try:
            while True:
                time.sleep(max(args.watch, 1))
                now = signature(root, only, skip)
                if now != seen:
                    print(f"\n{time.strftime('%H:%M:%S')} something moved, merging again", flush=True)
                    wt = merge_pass(root, only, skip)[0]
                    seen = signature(root, only, skip)
        except KeyboardInterrupt:
            return 0
    if args.restart:
        dropped = {}
        while True:
            # What a kept-only build held goes beside the running build's record, not over it.
            kept_only = "snapshot" if args.keep_only else "preview"
            write_left_out(wt, rows, f"{kept_only}-left-out")
            write_held(root, wt, base, rows, f"{kept_only}-held")
            code, output = restart(root, wt, args.dry_run, args.adopt, args.keep_only)
            more = cannot_take(root, base, rows, output, wt) if code != 0 else {}
            if not more:
                return code
            print("\n".join(f"{b}: {why}; merging again without it" for b, why in more.items()), flush=True)
            dropped.update(more)
            wt, base, rows = merge_pass(root, only, skip, dropped)
    return 0


if __name__ == "__main__":
    sys.exit(main())

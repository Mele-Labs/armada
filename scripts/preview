#!/usr/bin/env python3
#
# A rolling preview: every in-flight branch merged on top of `main`, in a
# worktree of its own, with no Checks, so work that has not landed can be used
# while agents land it. `docs/practices/running-locally.md`, "A preview of
# unlanded work", is what it does and what it never promises.
#
#   scripts/preview                      merge once, print the table
#   scripts/preview --only a --skip b    a branch list is repeatable or comma-separated
#   scripts/preview --watch [seconds]    merge again when a branch or main moves (60)
#   scripts/preview --restart [--dry-run] [--adopt]  then `scripts/restart --from .armada/preview`
#
# **A merge that does not build is left out and the restart run once more.**
# Git merges branches cut before something was deleted without a word, and
# `cargo install` then fails on code no branch of its own would have. When
# `--restart` fails with compiler errors, the branches that changed the files
# they name are dropped (`skipped (does not build: <files>)`), the rest merged
# again, and `scripts/restart` run a second time. Nothing in that touches a file
# the errors name, or a second failure, is reported as it is.
#
# Knobs for tests: `ARMADA_LAND_ARMADA` names the `armada` to ask about
# slots, and `ARMADA_PREVIEW_RESTART` the
# restart script `--restart` runs.

import argparse
import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.request

MIGRATIONS = "crates/store/migrations"
# The numbered list a branch cut before names still carries.
OLD_MIGRATIONS = "crates/store/src/migrations.rs"
# `preview` itself and `main` are never in flight.
NEVER = ("main", "preview")
# What `git clean` keeps: the build directories, the Bridge build stamp
# `scripts/restart` compares sources against, and the notes the owner pins from
# the Bridge he runs here, which the annotation layer writes under the checkout.
KEEP = ("/target", "node_modules", "/apps/desktop/out", "/.armada/annotations")


def git(cwd, *args, check=True):
    done = subprocess.run(
        ["git", *args], cwd=cwd, capture_output=True, text=True,
        env={**os.environ, "GIT_EDITOR": "true", "GIT_TERMINAL_PROMPT": "0"},
    )
    if check and done.returncode != 0:
        sys.exit(f"preview: git {' '.join(args)} failed in {cwd}: "
                 f"{(done.stderr or done.stdout).strip()}")
    return done


def out(cwd, *args):
    return git(cwd, *args).stdout.strip()


def repo_root():
    """The main checkout: the parent of the common git directory, so the
    preview lands in one place whichever slot this is run from."""
    common = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True)
    if common.returncode != 0:
        sys.exit("preview: not inside a git repository")
    return os.path.dirname(common.stdout.strip())


def armada(root, *args):
    binary = os.environ.get("ARMADA_LAND_ARMADA") or "armada"
    try:
        done = subprocess.run([binary, *args], cwd=root, capture_output=True, text=True)
    except OSError as why:
        sys.exit(f"preview: cannot run `{binary}` to ask what is in flight: {why}")
    if done.returncode != 0:
        sys.exit(f"preview: `{binary} {' '.join(args)}` said: "
                 f"{(done.stderr or done.stdout).strip()}")
    return done.stdout


# A Job in one of these holds work somebody can still use or answer for.
# Anything else with a branch, `running` without a Drone included, is stranded.
STRANDED = {"killed", "completed_failed", "rejected", "superseded"}


def fleet_get(path):
    """One read of Fleet's API, or None where Fleet is not running or does not answer."""
    runtime = os.path.join(os.path.expanduser("~"), "Library", "Application Support", "Armada", "fleet.json")
    try:
        with open(runtime) as f:
            port = json.load(f)["port"]
        with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=5) as r:
            return json.load(r)
    except (OSError, ValueError, KeyError):
        return None


def job_stopped(job_id, roster):
    """Whether a Job that holds a slot has stopped. Fleet silent means not known, so no."""
    answer = fleet_get(f"/jobs/{job_id}")
    if answer is None:
        return False
    status = answer["job"]["status"]
    return status in STRANDED or (status == "running" and job_id not in roster)


def slots(root):
    """Every slot that holds a branch: (slot, path, branch, why it is stranded or None)."""
    held = []
    roster, asked = None, False
    for line in armada(root, "worktree", "--status").splitlines():
        fields = re.split(r"\s{2,}", line.strip(), maxsplit=4)
        if len(fields) < 4 or fields[1] not in ("held", "kept"):
            continue
        holder = fields[4] if len(fields) > 4 else ""
        stranded = None
        if fields[1] == "kept":
            stranded = "held by a stopped Job"
        elif (m := re.match(r"by job (\S+)", holder)):
            if not asked:
                drones, asked = fleet_get("/drones"), True
                roster = {d["job_id"] for d in drones["drones"]} if drones else None
            if roster is not None and job_stopped(m.group(1), roster):
                stranded = "held by a stopped Job"
        held.append((fields[0], fields[2], fields[3].split()[0], stranded))
    return held


def base_of(root):
    """The newer of local `main` and `origin/main`, so a checkout that has not
    pulled still previews what has landed. Local `main` wins only where it is
    ahead of the remote; a diverged pair takes the remote, which is what lands."""
    have = [ref for ref in ("refs/heads/main", "refs/remotes/origin/main")
            if git(root, "rev-parse", "--verify", "--quiet", ref, check=False).returncode == 0]
    if not have:
        sys.exit("preview: neither `main` nor `origin/main` exists")
    if len(have) == 2:
        local_is_behind = git(root, "merge-base", "--is-ancestor", have[0], have[1], check=False).returncode == 0
        local_is_ahead = git(root, "merge-base", "--is-ancestor", have[1], have[0], check=False).returncode == 0
        return have[0] if local_is_ahead and not local_is_behind else have[1]
    return have[0]


def exists(root, branch):
    return git(root, "rev-parse", "--verify", "--quiet",
               f"refs/heads/{branch}", check=False).returncode == 0


def names(values):
    return {n.strip() for v in values or [] for n in v.split(",") if n.strip()}


def in_flight(root, base, only, skip):
    """(branches oldest first, why each named one was left out, slots held)."""
    held = slots(root)
    live = {b for _, _, b, why in held if not why}
    stranded = {b: why for _, _, b, why in held if why and b not in live}
    candidates = live | set(stranded)
    notes = []
    chosen = []
    for branch in sorted(candidates):
        if branch in NEVER or not exists(root, branch):
            continue
        ahead = out(root, "rev-list", "--count", f"{base}..{branch}")
        if ahead == "0":
            continue
        if branch in skip:
            notes.append(f"{branch}: skipped by --skip")
        elif branch in stranded:
            notes.append(f"{branch}: {stranded[branch]}")
        elif only and branch not in only:
            continue
        else:
            oldest = out(root, "log", "--reverse", "--format=%ct", f"{base}..{branch}").split()[0]
            chosen.append((int(oldest), branch))
    for name in sorted(only - {b for _, b in chosen}):
        if name not in skip:
            notes.append(f"{name}: named by --only, but it is not ahead of main in a slot")
    return [b for _, b in sorted(chosen)], notes, held


def migrations_in(cwd, rev):
    """The migration names at `rev`, in order. A migration is a file in
    `crates/store/migrations/`, so two branches that each add one merge; the
    same name in two files is a collision git cannot see."""
    found = []
    listed = git(cwd, "ls-tree", "--name-only", f"{rev}:{MIGRATIONS}", check=False)
    if listed.returncode == 0:
        for file in sorted(listed.stdout.split()):
            if m := re.fullmatch(r"\d{8}T\d{4}Z-([a-z0-9_]+\.[a-z0-9_.]+)\.sql", file):
                found.append(m.group(1))
    old = git(cwd, "show", f"{rev}:{OLD_MIGRATIONS}", check=False)
    inside = False
    for line in (old.stdout.splitlines() if old.returncode == 0 else []):
        if "pub const MIGRATIONS" in line:
            inside = True
        elif inside and line.strip() == "];":
            break
        elif inside and (m := re.match(r"^\s*(?:[\w]+::)*(V\d+),", line)):
            found.append(m.group(1))
    return found


def prepare(root, wt, base):
    git(root, "worktree", "prune")
    if not os.path.isdir(os.path.join(wt, ".git")) and not os.path.isfile(os.path.join(wt, ".git")):
        if os.path.exists(wt) and os.listdir(wt):
            sys.exit(f"preview: {wt} exists and is not a worktree; remove it and run again")
        os.makedirs(os.path.dirname(wt), exist_ok=True)
        git(root, "worktree", "add", "-q", "-B", "preview", wt, base)
    git(wt, "merge", "--abort", check=False)
    git(wt, "checkout", "-q", "-B", "preview", base)
    git(wt, "reset", "-q", "--hard", base)
    git(wt, "clean", "-xdffq", *[a for k in KEEP for a in ("-e", k)])


def merge_pass(root, only, skip, dropped=None):
    """Merge once; returns the worktree, the base and the table's rows.
    `dropped` is {branch: why}: branches a restart showed it cannot take."""
    dropped = dropped or {}
    wt = os.path.join(root, ".armada", "preview")
    git(root, "fetch", "--quiet", "origin", check=False)
    base = base_of(root)
    prepare(root, wt, base)
    branches, notes, held = in_flight(root, base, only, skip)

    taken = {v: "main" for v in migrations_in(wt, "HEAD")}
    rows = []
    for branch in branches:
        if branch in dropped:
            rows.append((branch, f"skipped ({dropped[branch]})", ""))
            continue
        # A branch that merged main can have several merge bases; one alone misses main's migrations.
        before = {v for mb in out(wt, "merge-base", "--all", "HEAD", branch).split() for v in migrations_in(wt, mb)}
        added = [v for v in migrations_in(wt, branch) if v not in before]
        clash = [(v, taken[v]) for v in added if v in taken]
        if clash:
            v, who = clash[0]
            rows.append((branch, f"skipped (migration {v} is already taken by {who})", ""))
            continue
        pre = out(wt, "rev-parse", "HEAD")
        done = git(wt, "merge", "--no-ff", "--no-edit", "-q", branch, check=False)
        if done.returncode != 0:
            files = out(wt, "diff", "--name-only", "--diff-filter=U").splitlines()
            git(wt, "merge", "--abort", check=False)
            rows.append((branch, "skipped (conflict: " + ", ".join(files or ["unknown"]) + ")", ""))
            continue
        head = out(wt, "rev-parse", "--short", "HEAD")
        if out(wt, "rev-parse", "HEAD") == pre:
            rows.append((branch, "nothing new", ""))
            continue
        for v in added:
            taken[v] = branch
        rows.append((branch, "merged", head))

    head = out(wt, "rev-parse", "--short", "HEAD")
    warnings = []
    for slot, path, branch, _ in held:
        if os.path.isdir(path):
            dirty = git(path, "status", "--porcelain", check=False).stdout.splitlines()
            if dirty:
                warnings.append(f"{slot} ({branch}) has {len(dirty)} uncommitted files, not included")
    text = render(base, out(root, "rev-parse", "--short", base), head, rows, notes, warnings)
    with open(os.path.join(wt, "PREVIEW.txt"), "w") as f:
        f.write(text)
    sys.stdout.write(text)
    sys.stdout.flush()
    return wt, base, rows


def render(base, base_sha, head, rows, notes, warnings):
    lines = [f"preview {head} = {base.split('/')[-1]} {base_sha} + in-flight branches",
             "Only committed work is included. No Checks were run.", ""]
    lines += [f"warning: {w}" for w in warnings] + [f"left out: {n}" for n in notes]
    if warnings or notes:
        lines.append("")
    if rows:
        width = max(len(r[0]) for r in rows)
        lines += [f"{b.ljust(width)}  {what}" + (f"  -> {sha}" if sha else "") for b, what, sha in rows]
    else:
        lines.append("no branch is ahead of main in a slot")
    lines += ["", f"preview head: {head}", ""]
    return "\n".join(lines)


def signature(root, only, skip):
    base = base_of(root)
    branches, _, _ = in_flight(root, base, only, skip)
    return (out(root, "rev-parse", base),
            tuple((b, out(root, "rev-parse", f"refs/heads/{b}")) for b in branches))


ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
# rustc places an error with `--> path:line:col`, under a header that says error or warning.
RUSTC_AT = re.compile(r"^\s*--> (.+?):\d+:\d+\s*$")
DIAGNOSTIC = re.compile(r"^(warning|error)\b")
# tsc says `path.ts(12,5)`; vite and esbuild say `path.ts:12:5`.
SCRIPT_AT = re.compile(r"([^\s()'\"]+\.(?:[cm]?[jt]sx?|vue|css))(?:\(\d+,\d+\)|:\d+:\d+)")
# Rollup names an import it cannot resolve by the importing file alone: `file: path`.
ROLLUP_FILE = re.compile(r"^file: (\S+?\.(?:[cm]?[jt]sx?|vue|css))(?::\d+:\d+)?\s*$")


def error_paths(output, wt):
    """The repo-relative files the compiler errors in `output` name."""
    prefixes = tuple(p + "/" for p in {wt, os.path.realpath(wt)})
    kind, found = None, []
    for line in ANSI.sub("", output).splitlines():
        if m := DIAGNOSTIC.match(line):
            kind = m.group(1)
        if (m := RUSTC_AT.match(line)):
            if kind == "error":
                found.append(m.group(1))
        elif (m := ROLLUP_FILE.match(line)):
            found.append(m.group(1))
        else:
            found += SCRIPT_AT.findall(line)
    paths = []
    for path in found:
        for prefix in prefixes:
            path = path.removeprefix(prefix)
        path = path.removeprefix("./")
        if path and not path.startswith(("/", "..")) and path not in paths:
            paths.append(path)
    return paths


def does_not_build(root, base, rows, output, wt):
    """{branch: files} for the merged branches that changed a file the compiler errors name,
    whole or by its tail."""
    named = error_paths(output, wt)
    culprits = {}
    for branch, what, _ in rows:
        if what != "merged":
            continue
        touched = set(out(root, "diff", "--name-only", f"{base}...{branch}").splitlines())
        # pnpm, tsc and vite print paths relative to the package (`src/App.tsx` for
        # `apps/desktop/src/App.tsx`), so a path no branch file equals is matched by its tail.
        files = []
        for path in named:
            files += [path] if path in touched else sorted(f for f in touched if f.endswith("/" + path))
        if files:
            culprits[branch] = files
    return culprits


LEAVE_OUT = re.compile(r"^restart: leave out (\S+): (.+)$")


def cannot_take(root, base, rows, output, wt):
    """{branch: why} for the merged branches this restart's output says it cannot take: the
    ones the migration guard names, else the ones the compiler errors name."""
    merged = {branch for branch, what, _ in rows if what == "merged"}
    guarded = {m.group(1): m.group(2) for m in map(LEAVE_OUT.match, output.splitlines()) if m}
    named = {branch: why for branch, why in guarded.items() if branch in merged}
    if named:
        return named
    return {branch: "does not build: " + ", ".join(files)
            for branch, files in does_not_build(root, base, rows, output, wt).items()}


def restart(root, wt, dry_run, adopt):
    """Run the restart script with its output flowing on as it always did, and
    return its exit code with all it said, for the errors to be read from."""
    script = os.environ.get("ARMADA_PREVIEW_RESTART") or os.path.join(root, "scripts", "restart")
    command = [script, "--from", wt] + (["--dry-run"] if dry_run else []) + (["--adopt"] if adopt else [])
    print("running " + " ".join(command), flush=True)
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    said = []

    def copy(pipe, stream):
        for line in iter(pipe.readline, b""):
            said.append(line)
            stream.buffer.write(line)
            stream.buffer.flush()

    copiers = [threading.Thread(target=copy, args=(child.stdout, sys.stdout)),
               threading.Thread(target=copy, args=(child.stderr, sys.stderr))]
    for t in copiers:
        t.start()
    code = child.wait()
    for t in copiers:
        t.join()
    print(f"scripts/restart {'would have' if dry_run else 'has'} built from {wt} and "
          f"serves the repository at {root}" if code == 0 else f"preview: restart exited {code}")
    return code, b"".join(said).decode("utf-8", "replace")


def main():
    ap = argparse.ArgumentParser(prog="scripts/preview", description=__doc__.strip() if __doc__ else None)
    ap.add_argument("--only", action="append", metavar="BRANCH", help="include only these")
    ap.add_argument("--skip", action="append", metavar="BRANCH", help="leave these out")
    ap.add_argument("--watch", nargs="?", const=60, type=int, metavar="SECONDS",
                    help="merge again when main or an included branch moves")
    ap.add_argument("--restart", action="store_true", help="then run scripts/restart --from the preview")
    ap.add_argument("--dry-run", action="store_true", help="with --restart: print, change nothing")
    ap.add_argument("--adopt", action="store_true", help="with --restart: restart Fleet with a Drone working, adopting it")
    args = ap.parse_args()
    if args.watch is not None and args.restart:
        sys.exit("preview: --watch never restarts Fleet. Run --restart on its own.")
    if args.adopt and args.watch is not None:
        sys.exit("preview: --adopt is for --restart, which --watch never runs")
    if args.adopt and not args.restart:
        sys.exit("preview: --adopt is for --restart")
    if args.dry_run and not args.restart:
        sys.exit("preview: --dry-run is for --restart")
    only, skip = names(args.only), names(args.skip)
    root = repo_root()

    wt, base, rows = merge_pass(root, only, skip)
    if args.watch is not None:
        seen = signature(root, only, skip)
        try:
            while True:
                time.sleep(max(args.watch, 1))
                now = signature(root, only, skip)
                if now != seen:
                    print(f"\n{time.strftime('%H:%M:%S')} something moved, merging again", flush=True)
                    wt = merge_pass(root, only, skip)[0]
                    seen = signature(root, only, skip)
        except KeyboardInterrupt:
            return 0
    if args.restart:
        dropped = {}
        while True:
            code, output = restart(root, wt, args.dry_run, args.adopt)
            more = cannot_take(root, base, rows, output, wt) if code != 0 else {}
            if not more:
                return code
            print("\n".join(f"{b}: {why}; merging again without it" for b, why in more.items()), flush=True)
            dropped.update(more)
            wt, base, rows = merge_pass(root, only, skip, dropped)
    return 0


if __name__ == "__main__":
    sys.exit(main())

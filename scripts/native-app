#!/usr/bin/env bash
#
# Make the native Bridge's `Armada.app`, signed ad hoc, from its cargo binary:
#
#   native-app <binary> <out dir> [<AppIcon.icns>]
#
# Prints the app's path. **The one place that bundle is made**: `scripts/keep-build`
# keeps one for a restart and the `release` job in `.github/workflows/checks.yml`
# ships one, and a second recipe would let the two differ.
#
# The binary is renamed to `Contents/MacOS/Armada`, because the Dock and the app
# switcher read the executable's file name (`scripts/armada-electron` has the
# measurement). The icon is the brand's, from beside this script unless one is
# given. The two notification tones go in Resources beside it. Armada Voice, the helper Talk hears and speaks
# through, goes in `Contents/Helpers`, built first when it is missing or stale. A caller that adds
# to the bundle afterwards signs it again: writing into a signed bundle breaks the seal.

set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

fail() {
  echo "native-app: $*" >&2
  exit 1
}

[[ $# -eq 2 || $# -eq 3 ]] || fail "usage: native-app <binary> <out dir> [<AppIcon.icns>]"
binary="$1" out="$2" icon="${3:-$here/../packages/brand/macos/AppIcon.icns}"
[[ -f "$binary" ]] || fail "$binary is not a file"
[[ -f "$icon" ]] || fail "$icon is missing"

app="$out/Armada.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
# An APFS clone where the volume allows one, else a plain copy.
cp -c "$binary" "$app/Contents/MacOS/Armada" 2>/dev/null || cp "$binary" "$app/Contents/MacOS/Armada"
chmod 755 "$app/Contents/MacOS/Armada"
cp "$icon" "$app/Contents/Resources/AppIcon.icns"
# The notification tones, in Resources, the first place macOS looks up a banner's sound by name. The same files
# Armada Classic bundles (`extraResources` in `apps/desktop/electron-builder.yml`); `crates/bridge-native/src/notify.rs` names them.
sounds="$here/../apps/desktop/sounds"
for tone in armada-blocked armada-waiting; do
  [[ -f "$sounds/$tone.wav" ]] || fail "$sounds/$tone.wav is missing"
  cp "$sounds/$tone.wav" "$app/Contents/Resources/$tone.wav"
done
# Armada Voice, the helper Talk hears and speaks through, as the Electron app carries it: in `Contents/Helpers`,
# where the binary looks first. Built here, by `node apps/desktop/native/voice/build.mjs`, when it is missing or older
# than a file in its folder, from the tree this script sits in or `$NATIVE_APP_TREE` (`scripts/keep-build` names its
# own). A build that fails says so in one line and the app is made without it: Talk then uses macOS Dictation.
tree="${NATIVE_APP_TREE:-$here/..}"
voice_dir="$tree/apps/desktop/native/voice"
voice="$voice_dir/build/Armada Voice.app"
voice_binary="$voice/Contents/MacOS/armada-voice"
if [[ -f "$voice_dir/build.mjs" ]] \
  && { [[ ! -x "$voice_binary" ]] || [[ -n "$(find "$voice_dir" -maxdepth 1 -type f -newer "$voice_binary")" ]]; }; then
  # Its own output goes to stderr, never stdout, which is this script's answer: the app's path.
  node "$voice_dir/build.mjs" >&2 || echo "native-app: Armada Voice did not build, so $app has no helper" >&2
fi
if [[ -x "$voice_binary" ]]; then
  mkdir -p "$app/Contents/Helpers"
  cp -R "$voice" "$app/Contents/Helpers/"
fi
python3 - "$app/Contents/Info.plist" <<'PY'
import plistlib, sys

plistlib.dump(
    {
        "CFBundleName": "Armada",
        "CFBundleDisplayName": "Armada",
        "CFBundleExecutable": "Armada",
        # Not Electron's: both Bridges can be open, and the system tells apps apart by this.
        "CFBundleIdentifier": "dev.armada.bridge.native",
        "CFBundleIconFile": "AppIcon",
        "CFBundlePackageType": "APPL",
        "CFBundleInfoDictionaryVersion": "6.0",
        "LSMinimumSystemVersion": "12.0",
        "NSHighResolutionCapable": True,
    },
    open(sys.argv[1], "wb"),
)
PY
codesign --force -s - "$app" >/dev/null 2>&1 || fail "could not sign $app"
echo "$app"

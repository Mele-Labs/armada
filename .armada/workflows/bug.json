# Bug, as the owner chose it on 27 Oct 2026: Find the cause, Fix, Short walk, Tests, Deliver. A bug he
# would see gets a short walk straight to the place before any test; one he would not, skips it.
# `.claude/decisions/2026-10-27-a-feature-job-walks-before-it-tests.md` has why. This file is also what
# Armada ships, and `feature.json` beside it is the other workflow that walks.
#
# Where the reasoning lives: `crates/core-model/domain/workflowdef-fields.toml` is the schema,
# `docs/concepts/workflow.md` the concept, `crates/config/src/workflow.rs` the parser. These files are
# YAML and the `.json` extension is kept on purpose: a `#` comment is not JSON. `workflow-samples/bug.json`
# is the designed seven-step form, not a duplicate of this one; do not reconcile the two.
#
# **`find_the_cause` records the plan**, the cause and the fix as tasks, because the walk is placed from
# the plan's approval. It asks how the work is delivered, as `feature`'s first step does.
#
# **`deliver` is gated `human_always`: every workflow that produces code stops before it lands**
# (the owner, Aug 28 2026). Auto land does not stop there (19 Oct 2026); Fleet declares the gate and does
# not enforce it, and the step's instructions carry the stop.
#
# **`no_behaviour_beyond_the_plan` asks about behaviour, not every line** (#190). Every definition here
# declares `for_requests`, read off its own criteria; `fleet`'s `tests::proposing` refuses one without.
{
  "version": 1,
  "workflow_id": "bug",
  "name": "bug",
  "for_requests": "Something that is broken: it used to work, or is meant to work, and does not, and what is wanted is the cause found and fixed. Taking a change that already landed back out whole is a revert, and adding or changing what the software does on purpose is a feature.",
  "steps": [
    {
      "id": "find_the_cause",
      "label": "Find the cause",
      "about": "Reads the report and the code, reproduces the bug and names the cause, then writes down the fix as tasks. Nothing is changed yet.",
      "instructions": "Reproduce the bug. Find why it happens, not only where it shows. Say the cause in a line.\nSay `seen: true` in record_plan when the person would see any piece of the change.\nName the root cause with file:line, not the reported symptom.\nPropose the fix beside it. If the fix changes what the person would see in Bridge, say so: a short walk of it comes before any test.\nSeparate what already exists from what is new: for each piece say done, partial or missing, with a path. Say partial when it is partial and which half is missing.\nList the tasks in the order they must happen. Tests come after the walk, so name none to write yet.\nName the files you expect to touch.\nOpen each function you plan to call and read its signature before writing it down. If an assumption from exploration was wrong, say so in the plan.\nSay when the work is bigger than it looked and which part grew.\nEnd with what you could not settle, each with file:line evidence.\nRecord the plan with record_plan and wait for the person to approve it. Edit nothing before then but a mock.",
      "evidence": {
        "submitted": {
          "type": "plan"
        }
      },
      "mechanical_checks": [
        {
          "type": "plan_recorded",
          "min_tasks": 1
        }
      ],
      "evidence_scope": {
        "context_source": "drone_declared"
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "plan_matches_request",
              "question": "Does this plan address the problem that was actually reported, rather than a different one?"
            },
            {
              "criterion_id": "names_a_root_cause",
              "question": "Does this plan name a specific root cause, rather than restating the reported symptom?"
            }
          ]
        }
      ],
      "delivers": false,
      "asks_delivery": true,
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "fix",
      "label": "Fix",
      "about": "Makes the fix from the plan, with no tests yet. The change is held in the Job's branch.",
      "instructions": "Make the smallest change that addresses the cause. Write no tests yet.\nWork the plan's tasks in order and finish each one.\nFollow the plan. A small correction, such as a signature that differs or a helper that already exists, is yours to make and to say. A change of approach goes to the person with ask_the_person.\nMatch the neighbouring code: naming, comment density, how errors are built.\nCommit in coherent pieces with messages that say why. Review reads only what is committed.",
      "evidence": {
        "submitted": {
          "type": "diff"
        }
      },
      "retry_limit": 2,
      "follows_plan": true,
      "mechanical_checks": [
        {
          "type": "diff_nonempty"
        }
      ],
      "declare_plan_at": "step_start",
      "evidence_scope": {
        "context_source": "drone_declared",
        "reference_docs": [
          "plan.evidence"
        ],
        "scope_diff_check": true
      },
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "addresses_the_cause",
              "question": "Does this diff address the root cause named in the plan, rather than masking the symptom?"
            },
            {
              "criterion_id": "no_behaviour_beyond_the_plan",
              "question": "Does this diff change behaviour beyond what the plan described?"
            },
            {
              "criterion_id": "tasks_match_the_diff",
              "question": "Does the diff do every task set to done or handed in, and does each dropped task's reason hold?"
            },
            {
              "criterion_id": "the_evidence_accounts_for_itself",
              "question": "For each task the plan records as done or handed in, does what it recorded under `shown` either demonstrate what that task recorded under `expects`, or say why the work proved it another way? A task that proved its work differently and says so is not a refusal on this criterion -- what is refused is a `shown` that neither matches nor accounts for itself. A task with no `expects` recorded, and a task neither done nor handed in, are both outside this question."
            }
          ]
        }
      ],
      "delivers": false,
      "advance_gate": "auto_if_judge_passes"
    },
    {
      "id": "short_walk",
      "label": "Short walk",
      "about": "Shows you the fix as a short walk straight to the place. No tests until you approve it. Passed over when nothing would be seen.",
      "instructions": "Show the fix as a short walk straight to the place. Notes come back as another take.\nShow it with show_window and wait for the person's approval. A bug nobody would see in Bridge needs no walk.",
      "walks": true,
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "tests",
      "label": "Tests",
      "about": "Writes the test that fails without the fix and passes with it, and runs the repository's checks on the result.",
      "instructions": "Write a test that fails without the fix and passes with it.\nRun the checks; if the suite is already red for other reasons, say so with ask_the_person and stop. Write the test on the narrowest observable failure, from the report's inputs, asserting what a person sees and not a helper you suspect. Read its failure message and confirm it fails for the reported reason.\nEvery new test is shown failing without the fix, for the right reason, then passing.\nRun the repository's checks before you report done. A failed check hands back its ids and log tails.\nCommit in coherent pieces with messages that say why. Review reads only what is committed.",
      "evidence": {
        "submitted": {
          "type": "failing_test"
        }
      },
      "retry_limit": 2,
      "mechanical_checks": [
        {
          "type": "every_manifest_check"
        },
        {
          "type": "diff_nonempty"
        }
      ],
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "deliver",
      "label": "Deliver",
      "about": "Delivers the finished change the way you chose: merged after ci, opened as a pull request, or kept on the branch.",
      "instructions": "Open the pull request and merge it on a green ci. Say what landed.\nDeliver by the delivery the person chose. Fleet told you the answer when it was given, or the first message named it. Do not ask again.\nReview the branch against the task with git log and git diff against the base. If anything blocks, put every blocker in one ask_the_person question and stop.\nLeave the branch landable: git status is empty, nothing the repository ignores is committed, noise commits such as wip or fix typo are squashed, and messages say why.\nAuto land: push the branch, open the pull request, watch ci until it finishes and merge when it is green. A red ci is fixed on the branch, never merged over.\nOpen PR only: push the branch and open the pull request. Stop there and do not merge.\nKeep local: stop at the commit on the Job's branch. Push nothing and open no pull request.\nReport the branch, what is on it, and what the person needs before merging: a follow-up not done, a decision they might reverse, a check that is green only because something unrelated was fixed.",
      "evidence": {
        "submitted": {
          "type": "review"
        }
      },
      "delivers": true,
      "advance_gate": "human_always"
    }
  ]
}

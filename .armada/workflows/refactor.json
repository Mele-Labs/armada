# Refactor, as the owner settled it on 9 Nov 2026: Scope, Restructure and review, Deliver. Each step is a
# plan group and `gate` names the fact Fleet sees for itself that ends it. `bug.json` beside this file says
# where the schema lives, and `.claude/decisions/2026-11-09-workflows-are-gated-plan-groups.md` has his
# answers.
#
# **Nothing he would see changes, and he still reads the diff** (dry run, 9 Nov): he approves the plan,
# then a page summarising the change before it merges. Scope did not record a plan before this, and
# Restructure ended on finished tasks, which is the agent's word.
#
# **`handoff` keeps its id** as the delivering step, which `crates/config/tests/shipped.rs` pins.
{
  "version": 1,
  "workflow_id": "refactor",
  "name": "refactor",
  "for_requests": "Reorganising code without changing what it does: moving, renaming, splitting or tidying, where nothing anyone can see or use changes -- no screen, no output, no behaviour. A request that adds, removes or changes anything a person sees or can do, however small, is a feature and not a refactor.",
  "steps": [
    {
      "id": "plan",
      "label": "Scope the refactor",
      "about": "Reads the code and writes down the restructure as a plan: what moves, what stays the same and which tests show it. Ends when you approve the plan.",
      "instructions": "Say what moves where, what behaviour stays the same, and which existing tests show it.\nList the tasks in the order they must happen. Name the files you expect to touch, and end with what you could not settle, each with file:line evidence.\nRecord the plan with record_plan and wait for the person to approve it. Change nothing before then.",
      "gate": "plan_approved",
      "asks_delivery": false,
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "implement",
      "label": "Restructure and review",
      "about": "Moves and renames code from the plan, runs the checks, and puts a page in front of you summarising the diff. Ends when you approve the page.",
      "instructions": "Work the plan's tasks in order. A small correction is yours to make and to say; a change of approach goes to the person.\nBehaviour does not change. A test you have to edit is a sign it moved. Run the checks locally.\nThen load the writing-a-document skill and write one HTML page to .armada/documents/<subject>.html summarising the diff: what moved where, what was renamed, what was left, and what the checks showed. Wait for the person to approve it, and answer every note by changing the code or the page.",
      "gate": "document_approved",
      "delivers": false,
      "advance_gate": "human_always"
    },
    {
      "id": "handoff",
      "label": "Deliver",
      "about": "Delivers the change the way you chose. Ends at the merge.",
      "instructions": "Push the branch and open the pull request. Deliver by the delivery the person chose, and do not ask again. Auto land: merge it on a green ci. Open PR: leave it open; the Job stays until it merges. Keep local: push nothing, and record this group's gate as none.\nA test that is also red on main is not this Job's to fix: look up who is fixing main, say so, and carry on.",
      "gate": "merged",
      "delivers": true,
      "advance_gate": "human_always"
    }
  ]
}

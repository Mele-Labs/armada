# Design Plan, the loop it was designed as. `bug.json` beside this file carries
# what all eight hold to, and where the schema, the catalogue and the Check
# reasoning live.
#
# `crates/core-model/domain/workflows.toml` calls this Armada's only
# instantiated loop: `draft` and `present`, with `present`'s `request_changes`
# routing back to `draft`. The routing and the cap of five are the designed
# file's; the cap lives on the step here rather than under
# `default_gate_policy`, which the parser still defers.
# `crates/fleet/src/tests/looping.rs` drives this file, off disk, round twice
# and then into a spent cap.
#
# **This workflow carries no Judge, and that is a decision rather than an
# omission.** The designed file carries none either: Design Plan is a
# back-and-forth the engineer ends when the design is in a good place, which
# `workflowdef-fields.toml` says treating as a config error would break. What
# ends it is `present`'s `human_always`, and what carries the reading back to
# `draft` is the loop.
#
# **`draft` writes a Document, and declares no `artifact_exists`.** The
# deliverable is the HTML page `docs/concepts/document.md` describes, named
# for its subject under `.armada/documents/`, which a fixed target cannot
# name. The check it carried named `.armada/artifacts/draft.md`, read by
# nothing at runtime, and told the agent to write markdown the person could
# not note.
#
# **`present` declares `phase: delivery`**: it sends nothing out, so the
# fallback off `delivers` would draw the step the person reads as the work.
#
# **`draft` records the plan, `#1006`.** It keeps the document, and `present`
# follows. `draft` is also the step a loop returns to, so each round records
# again — `WorkPlan::after` replaces a `Recorded` change whole, so a second
# round's recording is not a second plan beside the first, and
# `crates/fleet/src/tests/looping.rs` drives this file round twice to prove it.
{
  "version": 1,
  "workflow_id": "design_plan",
  "name": "design_plan",
  "for_requests": "Working out how something should be built before anybody builds it: a design or plan drafted, then revised with whoever asked until they are content, where the result is a document and no code is written. Trying the idea out in code is a prototype.",
  "steps": [
    {
      "id": "draft",
      "label": "Draft",
      "about": "Writes the design as a document and records the plan behind it. No code is written.",
      "instructions": "Write the design as a document: load the writing-a-document skill and write one HTML page to .armada/documents/<subject>.html, never a markdown file. Conclusion first, what was decided and by whom, a sketch inline where a flow or a structure needs one, and what is still open in its own section. Then record the plan behind it with record_plan. No code is written.",
      "records_plan": true,
      "evidence": {
        "submitted": { "type": "document" }
      },
      "mechanical_checks": [
        {
          "type": "plan_recorded"
        }
      ],
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "present",
      "label": "Present",
      "about": "Shows you the document. You approve it or send it back with notes for another draft.",
      "instructions": "The person reads the document in Bridge and notes it. Answer every note by changing the page where the note points and writing the same file again, as the writing-a-document skill says.",
      "phase": "delivery",
      "follows_plan": true,
      "evidence": {
        "submitted": { "type": "document" }
      },
      "delivers": false,
      "advance_gate": "human_always",
      "verdict_routing": {
        "request_changes": "draft"
      },
      "iteration_cap": 5
    }
  ]
}

# Design Plan, as the owner settled it on 9 Nov 2026: one group, ended by his approval of the design
# page. Draft and Present were two steps; the 12 disputes about them were the rail flagging the design
# page itself as an edit made too early, and pushes after he had approved. Each step is a plan group and
# `gate` names the fact Fleet sees for itself. `bug.json` beside this file says where the schema lives,
# and `.claude/decisions/2026-11-09-workflows-are-gated-plan-groups.md` has his answers.
#
# **This workflow carries no Judge.** Design Plan is a back-and-forth he ends when the design is in a good
# place, and his approval of the newest revision is that end.
#
# **What comes after the approval is his to say** (dry run, 9 Nov): the agent asks whether to stop there,
# start build Jobs, or build in this Job.
#
# **The plan stands unasked** (`records_plan`, `plan_unasked`): the page is what he approves, not the plan.
{
  "version": 1,
  "workflow_id": "design_plan",
  "name": "design_plan",
  "for_requests": "Working out how something should be built before anybody builds it: a design or plan drafted, then revised with whoever asked until they are content, where the result is a document and no code is written. Trying the idea out in code is a prototype.",
  "steps": [
    {
      "id": "draft",
      "label": "Draft and present",
      "about": "Writes the design as a page you read and note in Bridge, and revises it on your notes. Ends when you approve its newest revision.",
      "instructions": "Write the design as a document: load the writing-a-document skill and write one HTML page to .armada/documents/<subject>.html, never a markdown file. Conclusion first, what was decided and by whom, a sketch inline where a flow or a structure needs one, and what is still open in its own section. Record the plan behind it with record_plan: it stands without being asked, and the page is what the person approves. No code is written.\nAnswer every note by changing the page where the note points and writing the same file again.\nOnce the person approves the page, ask him what comes next: stop here, start build Jobs, or build it in this Job.",
      "gate": "document_approved",
      "records_plan": true,
      "plan_unasked": true,
      "mechanical_checks": [
        {
          "type": "plan_recorded"
        }
      ],
      "delivers": false,
      "advance_gate": "human_always"
    }
  ]
}

# Prototype, as the owner settled it on 9 Nov 2026: Frame, Build, Write up. Each step is a plan group and
# `gate` names the fact Fleet sees for itself that ends it. `bug.json` beside this file says where the
# schema lives, and `.claude/decisions/2026-11-09-workflows-are-gated-plan-groups.md` has his answers.
#
# **Build ends on his approval of a walk**, never on finished tasks (dry run, 9 Nov): even a prototype with
# nothing to see in Bridge is shown running. `evidence.walked` starts the repository's `walk` server in the
# Job's worktree for it.
#
# **What comes after the write-up is his to say**: some prototypes only answer his curiosity, and some
# prove an idea he wants to move on now. The agent asks once he approves the page.
#
# **No Judge**: a prototype answers a question and is thrown away, so there is no criterion to refuse.
# **`lands: spike`**: its Landing is the findings, and the code is not landed.
{
  "version": 1,
  "workflow_id": "prototype",
  "name": "prototype",
  "for_requests": "Trying something out to answer a question: a spike or rough version built to see whether an idea works, shown to whoever asked and written up, then thrown away rather than landed. Something meant to ship is a feature, and a design worked out on paper is a design plan.",
  "lands": "spike",
  "steps": [
    {
      "id": "frame",
      "label": "Frame",
      "about": "Says in a few lines what will be tried and how, as a plan. Ends when you approve it.",
      "instructions": "Say in three lines what you will try, how, and what would answer the question. Record it as the plan with record_plan and wait for the person to approve it. Write no code before then.",
      "gate": "plan_approved",
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "build",
      "label": "Build",
      "about": "Builds a rough version to answer the question and shows it to you running. Ends when you approve the walk.",
      "instructions": "Build the roughest version that answers the question. Show it running with show_window, naming this group: the app itself, or a small page of what it measured where nothing would be seen in the app. Wait for the person's approval.",
      "gate": "walk_approved",
      "evidence": {
        "walked": true
      },
      "delivers": false,
      "advance_gate": "human_always"
    },
    {
      "id": "write_up",
      "label": "Write up",
      "about": "Writes up what was tried and what it showed, as a page. Ends when you approve it. The code is not landed.",
      "instructions": "Load the writing-a-document skill and write one HTML page to .armada/documents/<subject>.html: the answer first, what was tried, what it measured, and what was not measured. Answer every note by changing the page.\nOnce the person approves the page, ask him whether to move forward with it now, as build Jobs or in this Job, or leave it as a write-up.",
      "gate": "document_approved",
      "delivers": false,
      "advance_gate": "auto"
    }
  ]
}

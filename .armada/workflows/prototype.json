# Prototype, as the owner settled it on 9 Nov 2026: Frame, Build, Write up. Each step is a plan group and
# `gate` names the fact Fleet sees for itself that ends it. `bug.json` beside this file says where the
# schema lives, and `.claude/decisions/2026-11-09-workflows-are-gated-plan-groups.md` has his answers.
#
# **Build ends on his Looks good on the branch offered**, never on finished tasks (dry run, 9 Nov): even a prototype
# with nothing to see in Bridge is offered, with a step that says how to run it. It was a walk until 20 Nov 2026, so
# `evidence.walked`, which started the repository's `walk` server for it, is gone.
#
# **What comes after the write-up is his to say**: some prototypes only answer his curiosity, and some
# prove an idea he wants to move on now. The agent asks once he approves the page.
#
# **No Judge**: a prototype answers a question and is thrown away, so there is no criterion to refuse.
# **`lands: spike`**: its Landing is the findings, and the code is not landed.
{
  "version": 1,
  "workflow_id": "prototype",
  "name": "Prototype",
  "for_requests": "Trying something out to answer a question: a spike or rough version built to see whether an idea works, shown to whoever asked and written up, then thrown away rather than landed. Something meant to ship is a feature, and a design worked out on paper is a design plan.",
  "lands": "spike",
  "steps": [
    {
      "id": "frame",
      "label": "Frame",
      "tabs": ["artifacts"],
      "about": "Says in a few lines what will be tried and how, as a plan. Ends when you approve it.",
      "instructions": "Say in three lines what you will try, how, and what would answer the question. Record it as the plan with record_plan and wait for the person to approve it. Write no code before then.",
      "gate": "plan_approved",
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "build",
      "label": "Build and try",
      "tabs": ["artifacts", "pulls"],
      "about": "Builds a rough version to answer the question and offers the branch for your preview. Ends when you press Looks good on its Ready to try card.",
      "instructions": "Build the roughest version that answers the question, on the branch, and push it.\nMake one group for this step, id build, gated you_approved. Offer the branch with offer_preview: `about` says in one line what it holds, `look` says in one line what to look at, and `steps` take him there, each aimed at an act in the registry where one does; where nothing is in the app, a step says the command that runs it or where what it measured is written. `about` and each step's `say` are at most 120 characters, and `look` at most 300.\nWait for his Looks good on the Ready to try card: it is his Approve and it ends this step. The card asks him itself, so end your turn without saying you wait for his Looks good, his try or the preview. Offer again after the branch moves or he leaves notes on it.\nShow no walks, and raise no waiting_for item with approves for what the card asks.\nA state only the native Bridge draws, which no live Fleet can reach, may still get a native walk, as the session-habits skill says.",
      "gate": "you_approved",
      "previews": true,
      "delivers": false,
      "advance_gate": "human_always"
    },
    {
      "id": "write_up",
      "label": "Write up",
      "tabs": ["artifacts"],
      "about": "Writes up what was tried and what it showed, as a page. Ends when you approve it. The code is not landed.",
      "instructions": "Load the writing-a-document skill and write one HTML page to .armada/documents/<subject>.html: the answer first, what was tried, what it measured, and what was not measured. Answer every note by changing the page.\nOnce the person approves the page, ask him whether to move forward with it now, as build Jobs or in this Job, or leave it as a write-up.",
      "gate": "document_approved",
      "delivers": false,
      "advance_gate": "auto"
    }
  ]
}

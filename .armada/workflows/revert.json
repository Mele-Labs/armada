# Revert, as the owner settled it on 9 Nov 2026: an optional plan, then Revert and deliver. Each step is a
# plan group and `gate` names the fact Fleet sees for itself that ends it. `bug.json` beside this file says
# where the schema lives, and `.claude/decisions/2026-11-09-workflows-are-gated-plan-groups.md` has his
# answers.
#
# **Whether he looks before a revert depends on the project, and he wants to be asked each time** (dry
# run, 9 Nov). The agent asks first; with a yes the plan group holds for his approval, with a no it is
# left out of the plan.
#
# **`handoff` keeps its id** as the delivering step, which `crates/config/tests/shipped.rs` pins.
{
  "version": 1,
  "workflow_id": "revert",
  "name": "revert",
  "for_requests": "Undoing a change that already landed: the commit or Job the request names, taken back out whole and nothing else with it. Keeping the change and fixing what it broke is a bug.",
  "steps": [
    {
      "id": "plan",
      "label": "Plan the revert",
      "about": "Asks whether you want to see a plan first. If you do, says what the revert takes out, including later work built on it, and ends when you approve it. Otherwise left out.",
      "instructions": "Before anything else, ask the person whether he wants a plan before this revert.\nIf yes: find the change, and say what the revert takes out, including any later work built on it that would conflict. Record it with record_plan and wait for his approval.\nIf no: leave this group out of the plan.",
      "gate": "plan_approved",
      "asks_delivery": false,
      "delivers": false,
      "advance_gate": "auto"
    },
    {
      "id": "handoff",
      "label": "Revert and deliver",
      "about": "Takes the named change back out and nothing else, runs the checks, and delivers it the way you chose. Ends at the merge.",
      "instructions": "Revert the named change with git revert, and nothing else with it. Resolve a conflict with later work by keeping the later work and taking out only what the named change added; say what you kept.\nRun the checks locally. A test that is also red on main is not this Job's to fix: say so and carry on.\nPush the branch and open the pull request. Deliver by the delivery the person chose, and do not ask again. Auto land: merge it on a green ci. Open PR: leave it open; the Job stays until it merges. Keep local: push nothing, and record this group's gate as none.",
      "gate": "merged",
      "delivers": true,
      "advance_gate": "human_always"
    }
  ]
}

# Epic -- a milestone dispatched as one Job. Its product is not a diff, it is
# other Jobs. #215; `docs/capabilities/epic-as-one-job.md` is the reasoning at
# length, `crates/core-model/domain/workflows.toml` the catalogue row, and
# `bug.json` beside this file what every definition here holds to.
#
# **This is the only definition that ships with `may_dispatch_jobs`**, on
# `plan` alone. `crates/config/tests/shipped.rs` asserts that pair and says
# why that step alone may have it.
#
# **`plan` proposes the wave and a person answers it, on one step.** Since
# spike 022's slice 6 a Job `dispatch_job` creates waits at
# `awaiting_approval`: it is real, and it runs nothing until `approve_wave`
# releases the whole wave at this step's `human_always` gate. So the person
# reads the Jobs themselves rather than a description of them, corrects or
# drops any of them, and one press starts the rest
# (`.claude/decisions/2026-09-30-approving-an-epics-plan-releases-its-wave.md`).
# The `dispatch` step that used to carry the plan out after the gate is gone:
# there is nothing left to carry out once the Jobs exist.
#
# **The Judge's refusal at `plan` now arrives after the Jobs exist**, and
# costs nothing: they have not run, and a retried `plan` withdraws what its
# last attempt proposed before proposing again (`fleet::waving`). Both
# criteria stay: one asks whether the split is drawn, the other whether each
# piece carries what `dispatch_job` is asked for -- a brief and a bar.
#
# **What the Drone is told about any of this is `fleet::terms`', not this
# file's.** A step definition has no field for prose. `Splitting` in
# `crates/fleet/src/terms.rs` is the block, and it is keyed off
# `may_dispatch_jobs` on this step rather than off this workflow's name.
#
# **`roll_up` declares `phase: delivery`**, `design-plan.json`'s reason for
# `present`: what an Epic delivers is its roll-up, not a pull request.
#
# **`plan` records the plan, `#1006`.** It keeps its split, `plan.md`, and
# `roll_up` follows it. `plan` is also where the loop returns, so a second
# pass records again — `WorkPlan::after` replaces a `Recorded` change whole,
# which is what keeps a second split from reading as two plans — and proposes
# the next wave, stamped with its pass.
{
  "version": 1,
  "workflow_id": "epic",
  "name": "epic",
  "for_requests": "Finishing a milestone or an epic: a link to one, or a list of issues somebody wants done as a whole, which is too much for one change and has to be split into several Jobs that run in turn.",
  "structure": "loop",
  "steps": [
    {
      "id": "plan",
      "label": "Plan the wave",
      "records_plan": true,
      "may_dispatch_jobs": true,
      "evidence": {
        "submitted": { "type": "document" }
      },
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": ".armada/artifacts/plan.md"
        },
        {
          "type": "plan_recorded"
        }
      ],
      "judge_checks": [
        {
          "enabled": true,
          "model": "haiku",
          "criteria": [
            {
              "criterion_id": "draws_the_split",
              "question": "Does this plan draw the split -- a node for each Job it proposes, and an edge wherever one of them has to wait for another -- rather than describing the split in prose alone?"
            },
            {
              "criterion_id": "each_piece_carries_its_own_brief",
              "question": "Does the plan say, for every Job it proposes, what that Job's agent is to be told and what its work will be held to, rather than naming the piece and leaving both to be worked out later?"
            }
          ]
        }
      ],
      "delivers": false,
      "advance_gate": "human_always"
    },
    {
      "id": "roll_up",
      "label": "Roll up the wave",
      "phase": "delivery",
      "follows_plan": true,
      "evidence": {
        "submitted": { "type": "document" }
      },
      "mechanical_checks": [
        {
          "type": "artifact_exists",
          "target": ".armada/artifacts/roll-up.md"
        }
      ],
      "delivers": false,
      "advance_gate": "human_always",
      "verdict_routing": {
        "request_changes": "plan"
      },
      "iteration_cap": 5
    }
  ]
}

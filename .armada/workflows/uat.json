# UAT, as the owner settled it on 9 Nov 2026: Set up, run and report, then Write back. Each step is a plan
# group and `gate` names the fact Fleet sees for itself that ends it. `bug.json` beside this file says
# where the schema lives, and `.claude/decisions/2026-11-09-workflows-are-gated-plan-groups.md` has his
# answers.
#
# **`carries_no_code: true` is the whole difference from `design_plan.json`.** A Job on this flow writes
# no code, so Fleet asks it for no branch, slot, test, push, pull request or merge, and its commands run
# without a leased slot.
#
# **Nothing here names a company, project, environment or tool.** The environment, the scenarios and the
# sheet they come from are whatever the request names.
#
# **One stop, at the results** (dry run, 9 Nov): blocked scenarios are asked about while the rest run, not
# before. None of Set up, Pre-flight and Run ended on a fact Fleet sees, so they are the agent's own
# tasks inside the first group.
{
  "version": 1,
  "workflow_id": "uat",
  "name": "uat",
  "for_requests": "Running acceptance scenarios against a test environment and writing the results back to the sheet they came from, where no code is written, changed or delivered.",
  "carries_no_code": true,
  "steps": [
    {
      "id": "review",
      "label": "Set up, run and report",
      "about": "Sets up the test environment, runs every scenario it can and asks you about the blocked ones meanwhile, then shows you the results as a page. Ends when you approve the results.",
      "instructions": "Pick the test environment with the person: the sites, the test accounts, the log source, and the scripts and commands this Job may run. Check each is reachable and say which is not.\nMark every scenario runnable, blocked with the reason, or needs the person. Run the runnable ones one at a time, keeping evidence for every step: what was done, what was seen, and where it was read from. Put the blocked ones to the person while the rest run, and run each as he settles it.\nRecord every change made to the environment, and how it was restored, as it happens.\nWrite the results to one page in .armada/documents/: scenario by scenario with its evidence, and the changes made to the environment in the same place. Wait for the person to approve it, and answer each note by changing the page.",
      "gate": "document_approved",
      "phase": "delivery",
      "delivers": false,
      "advance_gate": "human_always"
    },
    {
      "id": "writeback",
      "label": "Write back",
      "about": "Writes the approved results to the scenario sheet, and the Job ends.",
      "instructions": "Write the approved results to the scenario sheet, say what was written, and end the Job. Open no pull request and make no branch.",
      "phase": "delivery",
      "delivers": false,
      "advance_gate": "auto"
    }
  ]
}

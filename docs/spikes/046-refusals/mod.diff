+/**
+ * Spike 46: a call refused while a gate Fleet keeps is open. The gate keeper writes the record to
+ * `$HOME/.spike046/<session id>/record.json`; a session with no record is never refused. The refusal is one
+ * sentence naming the open gate, and nothing else.
+ */
+async function gateRefusal($: Dollar, tool: string, input: Record<string, unknown>): Promise<string | undefined> {
+  const home = await $.env.get('HOME')
+  const id = await $.session.id().catch(() => '')
+  if (!home || !id) return undefined
+  const text = await $.fs.read(`${home}/.spike046/${id}/record.json`).catch(() => undefined)
+  if (typeof text !== 'string') return undefined
+  const gates = (JSON.parse(text) as { gates?: Record<string, { name?: string; closed_at?: unknown }> }).gates ?? {}
+  const open = Object.values(gates).filter(gate => !gate.closed_at)
+  if (open.length === 0) return undefined
+  const planOpen = !gates.plan_approved?.closed_at
+  if (tool === 'mcp__armada-fleet__all_done') return `Gate open: ${open.map(gate => gate.name).join('; ')}.`
+  if (!planOpen) return undefined
+  const stood = `Gate open: ${gates.plan_approved?.name}.`
+  if (tool === 'Bash') {
+    const command = String(input.command ?? '')
+    return /\bgit\b[^|;&\n]*?\bpush\b/.test(command) && !/--dry-run/.test(command) ? stood : undefined
+  }
+  const path = input.file_path
+  if (typeof path !== 'string' || path.includes('/.armada/') || !path.includes('/')) return undefined
+  const dir = path.slice(0, path.lastIndexOf('/'))
+  if (!(await $.fs.exists(path).catch(() => false))) return undefined
+  const listed = await $.process.run(['git', '-C', dir, 'ls-files', '--error-unmatch', '--', path]).catch(() => undefined)
+  return listed?.exitCode === 0 ? stood : undefined
+}

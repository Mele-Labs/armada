// The formatter for the TypeScript half: apps/ and packages/, nothing else.
// A fixed width, and every literal one item per line, so two features stop
// sharing a line and stop conflicting on it. Formatting only: no lint, no
// import sorting. classic-final:docs/practices/bridge.md, *The formatter*.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      // Generated, and compared byte for byte with what the generator writes.
      // The sources are parsed one line at a time by `xtask/src/tokens.rs`.
      "!packages/tokens",
      // Generated from `crates/ipc` by `cargo xtask verify-wire`, and compared byte for byte.
      "!apps/pocket/src/wire",
      // Compiled into Fleet, and a test pins the CSS text.
      "!packages/mods"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    // Every object and list literal one item per line, even a short one, so
    // an added field is a line of its own. The owner's choice, 2 Nov 2026.
    "expand": "always"
  },
  // Double quotes: several gate rules and tests split source on `"`.
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  // Pocket's stylesheet tells Tailwind not to scan its `kit/` (`@source not`), a directive Biome reads only when asked.
  "overrides": [
    {
      "includes": [
        "apps/pocket/src/styles.css"
      ],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    }
  ],
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}

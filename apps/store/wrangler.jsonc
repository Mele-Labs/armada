{
  "name": "armada-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT",
        "class_name": "Account"
      }
    ]
  },
  // `TEAM` (`org` or `org/team-slug`) is set at deploy time and makes this a team store.
  // Enrol calls the forge, so an address gets 10 a minute. The binding counts per Cloudflare location,
  // and `namespace_id` is any integer no other limiter on the account uses.
  "ratelimits": [
    {
      "name": "ENROL_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Account"
      ]
    }
  ]
}
